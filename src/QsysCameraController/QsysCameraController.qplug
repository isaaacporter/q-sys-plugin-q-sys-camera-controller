-- Group boxes in the order they stack down each page.
--   cols2  label + control in each of two columns (the default)
--   cols1  one right-aligned label column, control to its right
--   pairs  row label at left, then a Preview and a Mediacast column
-- y/h/w are the measured position and size, 4 less than Designer reports
-- because of the plugin's inherent inset. Groups without them stack
-- automatically at 11 + rows*19.
CamGroups = {
  {page = "Imaging",      name = "Imaging",         rows = 2, style = "cols2", y = 16,  h = 59},
  -- Exposure's left column is a wider label over a narrower control than the
  -- Imaging group's, so it carries its own column geometry.
  {page = "Imaging",      name = "Exposure",        rows = 6, style = "cols2", y = 91,  h = 135,
   cols = {{lblX = 4, lblW = 96, ctlX = 103, ctlW = 96},
           {lblX = 202, lblW = 96, ctlX = 301, ctlW = 128}}},
  {page = "Imaging",      name = "White Balance",   rows = 5, style = "cols2", y = 242, h = 116,
   cols = {{lblX = 4, lblW = 96, ctlX = 103, ctlW = 96},
           {lblX = 202, lblW = 96, ctlX = 301, ctlW = 128}}},
  {page = "Imaging",      name = "Noise Reduction", rows = 1, style = "cols2", y = 374, h = 40,
   cols = {{lblX = 4, lblW = 96, ctlX = 103, ctlW = 96},
           {lblX = 202, lblW = 96, ctlX = 301, ctlW = 128}}},
  {page = "Imaging",      name = "SDI/HDMI Format", rows = 5, style = "cols1", y = 430, h = 116, w = 432,
   cols = {{lblX = 4, lblW = 150, ctlX = 158, ctlW = 150}}},
  {page = "Auto Framing", name = "Auto Framing",    rows = 6, style = "cols1",
   y = 0, h = 135, w = 435,
   cols = {{lblX = 4, lblW = 96, ctlX = 103, ctlW = 192}}},
  {page = "Mediacast Streams", name = "IP Streams", rows = 7, style = "pairs",
   y = 0, h = 154, w = 436, lblW = 100,
   -- The Preview heading is narrower than its column, because the Enable
   -- button shares the heading row with it.
   cols = {{ctlX = 107, ctlW = 160, hdrW = 120}, {ctlX = 272, ctlW = 160}},
   headers = {"Preview Stream", "Mediacast Stream"}},
  {page = "Status",       name = "Status",           rows = 2, style = "cols1", y = 0,   h = 83, w = 435, cols = {{lblX = 4, lblW = 96, ctlX = 103, ctlW = 192}}},
  {page = "Status",       name = "Network",          rows = 3, style = "cols1", y = 99,  h = 81, w = 435, cols = {{lblX = 4, lblW = 96, ctlX = 103, ctlW = 128}}},
  {page = "Status",       name = "Hardware Details", rows = 3, style = "cols1", y = 180, h = 78, w = 435, cols = {{lblX = 4, lblW = 112, ctlX = 119, ctlW = 304}}}
}

-- Page-level trigger buttons that sit above the first group box.
CamPageTriggers = {
  {page = "Imaging", name = "setup.reset.settings", pretty = "Imaging~Reset Cam Settings",
   label = "Reset all Camera settings (Imaging, PTZ, and Focus)"}
}

-- Static captions that sit on a row but have no control behind them.
CamTexts = {
  {page = "Mediacast Streams", group = "IP Streams", row = 4, x = 243, w = 26, text = "fps"}
}

-- Fast lookup by control name.
CamCtlByName = {}
for _, d in ipairs(CamCtls) do CamCtlByName[d.name] = d end
for _, t in ipairs(CamPageTriggers) do
  CamCtlByName[t.name] = {name = t.name, pretty = t.pretty, kind = "trigger", label = t.label}
end

-- Define the colour of the plugin object in the design
function GetColor(props)
  return Palette.cti_navy
end

-- The name that initially displays when dragged into a design
function GetPrettyName(props)
  return "Q-SYS Camera Controller v" .. PluginInfo.Version
end

-- Optional function used if the plugin has multiple pages
function GetPages(props)
  local pages = {}
  for ix in ipairs(PageNames) do
    table.insert(pages, {name = PageNames[ix]})
  end
  return pages
end

-- Optional function to define model if the plugin supports more than one model
function GetModel(props)
  local model = {}
  -- Single model; nothing to define.
  return model
end

-- Define user-configurable Properties of the plugin
function GetProperties()
  local props = {}
  table.insert(props, {
    Name = "Camera Count",
    Type = "integer",
    Value = 2,
    Min = 1,
    Max = 16
  })
  table.insert(props, {
    Name = "Num Presets",
    Type = "integer",
    Value = 6,
    Min = 0,
    Max = 64
  })
  table.insert(props, {
    Name = "Hold to Save (s)",
    Type = "double",
    Value = 3.0,
    Min = 0.2,
    Max = 10.0
  })
  table.insert(props, {
    Name = "Debug Print",
    Type = "enum",
    Choices = {"None", "Function Calls", "Tx", "All"},
    Value = "None"
  })
  return props
end

-- Optional function to define pins not connected to a Control
function GetPins(props)
  local pins = {}
  -- All pins are derived from Controls (UserPin); no extra pins required.
  return pins
end

-- Optional function to update available properties when properties are altered
function RectifyProperties(props)
  -- No conditional property visibility required.
  return props
end

-- Optional function to define components used within the plugin
function GetComponents(props)
  local components = {}
  -- This plugin proxies to camera components elsewhere in the design at runtime
  -- via the Component library; it hosts no internal components.
  return components
end

-- Optional function to define wiring of components used within the plugin
function GetWiring(props)
  local wiring = {}
  -- No internal components, so no wiring.
  return wiring
end

-- Defines the Controls used within the plugin
function GetControls(props)
  local ctrls = {}
    local fmt = string.format
    local CameraCount = props["Camera Count"].Value
    local NumPresets  = props["Num Presets"].Value
  
    -- Camera selection -----------------------------------------------------------
    table.insert(ctrls, {
      Name = "active_camera_name",
      ControlType = "Indicator",
      IndicatorType = "Text",
      PinStyle = "Output",
      Count = 1,
      UserPin = true
    })
    -- Hidden, persistent storage for numbered preset coordinates (JSON).
    table.insert(ctrls, {
      Name = "preset_store",
      ControlType = "Text",
      Count = 1,
      UserPin = false
    })
    -- Status indicators
    table.insert(ctrls, {
      Name = "is_moving",
      ControlType = "Indicator",
      IndicatorType = "Led",
      DefaultValue = false,
      Count = 1,
      UserPin = true,
      PinStyle = "Output"
    })
    table.insert(ctrls, {
      Name = "preset_saved",
      ControlType = "Indicator",
      IndicatorType = "Led",
      DefaultValue = false,
      Count = 1,
      UserPin = true,
      PinStyle = "Output"
    })
    table.insert(ctrls, {
      Name = "coordinates",
      ControlType = "Text",
      Count = 1,
      UserPin = true,
      PinStyle = "Both"
    })
  
    -- Camera tracking via a router / mediacast router
    table.insert(ctrls, {
      Name = "router_select",
      ControlType = "Text",
      Count = 1,
      UserPin = true,
      PinStyle = "Both"
    })
    table.insert(ctrls, {
      Name = "router_output",
      ControlType = "Knob",
      ControlUnit = "Integer",
      Min = 1,
      Max = 64,
      DefaultValue = 1,
      Count = 1,
      UserPin = true,
      PinStyle = "Both"
    })
    table.insert(ctrls, {
      Name = "router_found",
      ControlType = "Indicator",
      IndicatorType = "Led",
      DefaultValue = false,
      Count = 1,
      UserPin = true,
      PinStyle = "Output"
    })
    table.insert(ctrls, {
      Name = "tracked_source",
      ControlType = "Indicator",
      IndicatorType = "Text",
      Count = 1,
      UserPin = true,
      PinStyle = "Output"
    })
  
    for i = 1, CameraCount do
      table.insert(ctrls, {
        Name = fmt("camera_active_%03d", i),
        ControlType = "Button",
        ButtonType = "Toggle",
        Count = 1,
        UserPin = true,
        PinStyle = "Both"
      })
      table.insert(ctrls, {
        Name = fmt("camera_select_%03d", i),
        ControlType = "Text",
        Count = 1,
        UserPin = true,
        PinStyle = "Both"
      })
      table.insert(ctrls, {
        Name = fmt("camera_found_%03d", i),
        ControlType = "Indicator",
        IndicatorType = "Led",
        DefaultValue = false,
        Count = 1,
        UserPin = true,
        PinStyle = "Output"
      })
    end
  
    -- Shared Pan / Tilt / Zoom / Focus -------------------------------------------
    -- Built-in icons must be declared on the control (not the layout).
    local ptzButtons = {
      {name = "ptz_up_left",    icon = "Arrow Left-Up"},
      {name = "ptz_tilt_up",    icon = "Arrow Up"},
      {name = "ptz_up_right",   icon = "Arrow Right-Up"},
      {name = "ptz_pan_left",   icon = "Arrow Left"},
      {name = "ptz_pan_right",  icon = "Arrow Right"},
      {name = "ptz_down_left",  icon = "Arrow Left-Down"},
      {name = "ptz_tilt_down",  icon = "Arrow Down"},
      {name = "ptz_down_right", icon = "Arrow Right-Down"},
      {name = "ptz_zoom_in",    icon = "Zoom In"},
      {name = "ptz_zoom_out",   icon = "Zoom Out"},
      {name = "ptz_focus_in",  icon = "Plus"},
      {name = "ptz_focus_out", icon = "Minus"}
    }
    for _, b in ipairs(ptzButtons) do
      local def = {
        Name = b.name,
        ControlType = "Button",
        ButtonType = "Momentary",
        Count = 1,
        UserPin = true,
        PinStyle = "Input"
      }
      if b.icon then def.Icon = b.icon end
      table.insert(ctrls, def)
    end
  
    -- Home / Privacy -------------------------------------------------------------
    local triggerButtons = {
      {name = "ptz_home", icon = "Home"},
      {name = "ptz_af"},
      {name = "home_save"},
      {name = "privacy_save"}
    }
    for _, b in ipairs(triggerButtons) do
      local def = {
        Name = b.name,
        ControlType = "Button",
        ButtonType = "Trigger",
        Count = 1,
        UserPin = true,
        PinStyle = "Input"
      }
      if b.icon then def.Icon = b.icon end
      table.insert(ctrls, def)
    end
  
    -- Privacy is a toggle reflecting the camera's privacy mode.
    table.insert(ctrls, {
      Name = "privacy_load",
      ControlType = "Button",
      ButtonType = "Toggle",
      Icon = "Prohibited",
      Count = 1,
      UserPin = true,
      PinStyle = "Both"
    })
  
    -- Proxied camera controls ----------------------------------------------------
    -- Emitted from the registry so a control is declared exactly once. Each keeps
    -- the camera's own control name, so the pin lines up with what it drives.
    local KIND_DEF = {
      int       = function(d) return {ControlType = "Knob", ControlUnit = "Integer", Min = d.min, Max = d.max, DefaultValue = d.min, PinStyle = "Both"} end,
      float     = function(d) return {ControlType = "Knob", ControlUnit = "Float",   Min = d.min, Max = d.max, DefaultValue = d.min, PinStyle = "Both"} end,
      text      = function(d) return {ControlType = "Text", PinStyle = "Both"} end,
      bool      = function(d) return {ControlType = "Button", ButtonType = "Toggle", PinStyle = "Both"} end,
      enum      = function(d) return {ControlType = "Text", PinStyle = "Both"} end,
      ro        = function(d) return {ControlType = "Indicator", IndicatorType = "Text", PinStyle = "Output"} end,
      -- A text field the layout presents as a MediaDisplay; the runtime only
      -- feeds it the camera's preview string.
      media     = function(d) return {ControlType = "Text", PinStyle = "Output"} end,
      led       = function(d) return {ControlType = "Indicator", IndicatorType = "Led", DefaultValue = false, PinStyle = "Output"} end,
      status    = function(d) return {ControlType = "Indicator", IndicatorType = "Status", PinStyle = "Output"} end,
      trigger   = function(d) return {ControlType = "Button", ButtonType = "Trigger", PinStyle = "Input"} end,
      -- Momentary rather than Trigger so the lit state can follow <name>.state.
      statetrig = function(d) return {ControlType = "Button", ButtonType = "Momentary", PinStyle = "Both"} end
    }
  
    local function EmitCamCtl(d)
      local def = KIND_DEF[d.kind](d)
      def.Name = d.name
      def.Count = 1
      def.UserPin = true
      table.insert(ctrls, def)
    end
  
    for _, d in ipairs(CamCtls) do EmitCamCtl(d) end
    for _, t in ipairs(CamPageTriggers) do EmitCamCtl({name = t.name, kind = "trigger"}) end
  
    -- Numbered presets (tap = recall, hold = save). The button itself lights
    -- (its .Boolean is driven) when the camera is at that stored position.
    for p = 1, NumPresets do
      table.insert(ctrls, {
        Name = fmt("preset_%03d", p),
        ControlType = "Button",
        ButtonType = "Momentary",
        Count = 1,
        UserPin = true,
        PinStyle = "Both"
      })
    end
  return ctrls
end

-- Layout of controls and graphics for the plugin UI
function GetControlLayout(props)
  local layout = {}
  local graphics = {}
    local fmt = string.format
    local pidx = (props["page_index"] and props["page_index"].Value) or 1
    local CurrentPage = PageNames[pidx]
  
    local CameraCount = props["Camera Count"].Value
    local NumPresets  = props["Num Presets"].Value
  
    local fs1  = 11   -- all label text on the native pages is 11pt
    local fsM  = 9    -- value text inside a meter
    local h1   = 20
    local hB   = 32
    local rowH = 30
  
    -- The native camera block is 435px wide and every group box fills it.
    local PLUGIN_W  = 435
    local rightEdge = PLUGIN_W
  
    -- Camera group geometry (Setup page)
    local camGX, camGY = 0, 44
    local camGW = PLUGIN_W
    local rowY0 = camGY + 28
    local footerY = rowY0 + CameraCount * rowH + 8
    local camGH = (footerY + 26) - camGY + 8
  
    -- Pan / Tilt / Zoom group geometry (styled like the native QSC camera block)
    -- Designer insets the whole plugin by 4px on the top and sides, so every
    -- position here is 4 less than what its properties panel reports.
    local ptzGX, ptzGY = 0, 0
    local ptzGW  = PLUGIN_W
    -- 4-column x 3-row button grid: three pad columns then a zoom column.
    local padX, padY = 74, 20
    local padPitch   = 35
    local zoomX      = padX + 3 * padPitch          -- 179
    -- Home / Privacy: label, icon, then the red save button.
    local hpLblX, hpIconX, hpSaveX = 214, 265, 300
    local hpLblW, hpIcon, hpSaveW  = 48, 32, 32
    -- Left column: 102-wide labels at x=4 with controls at x=109. Coordinates
    -- sits on its own row above the toggles.
    local lblX, lblW = 4, 102
    local ctlX       = 109
    local coordsY    = 125
    local ptzRow0    = 144       -- first toggle row
    local ptzRowH    = 19
    local ptzGH      = 240
  
    if CurrentPage == "Setup" then
  
      -- Title / build info -----------------------------------------------------
      table.insert(graphics, {
        Type = "Text", Text = "Q-SYS Camera Controller", FontSize = 16,
        FontStyle = "Bold", HTextAlign = "Left", Color = Palette.text,
        Position = {0, 4}, Size = {360, 24}
      })
      table.insert(graphics, {
        Type = "Text", Text = "v" .. PluginInfo.BuildVersion, FontSize = fs1,
        HTextAlign = "Right", Color = Palette.Gray,
        Position = {rightEdge - 120, 8}, Size = {120, h1}
      })
  
      -- Camera selection group -------------------------------------------------
      table.insert(graphics, {
        Type = "GroupBox", Text = "Cameras", FontSize = fs1, HTextAlign = "Left",
        Color = Palette.text, StrokeColor = Palette.Black, StrokeWidth = 1,
        CornerRadius = 8, Position = {camGX, camGY}, Size = {camGW, camGH}
      })
  
      for r = 0, CameraCount - 1 do
        local i = r + 1
        local y = rowY0 + r * rowH
        layout[fmt("camera_active_%03d", i)] = {
          PrettyName = fmt("Cameras~%d Select", i),
          Legend = tostring(i), Style = "Button",
          Color = {0, 210, 70}, OffColor = {13, 59, 102}, UnlinkOffColor = true,
          Margin = 3, Position = {camGX + 8, y}, Size = {26, 26}
        }
        layout[fmt("camera_select_%03d", i)] = {
          PrettyName = fmt("Cameras~%d Component", i),
          Style = "ComboBox", FontSize = fs1, Color = Palette.White,
          Padding = 2, StrokeWidth = 1,
          Position = {camGX + 40, y + 1}, Size = {camGW - 76, 24}
        }
        layout[fmt("camera_found_%03d", i)] = {
          PrettyName = fmt("Cameras~%d Found", i),
          Style = "Indicator", Color = Palette.Green, OffColor = {16, 40, 24},
          UnlinkOffColor = true, StrokeWidth = 1, Margin = 2,
          Position = {camGX + camGW - 28, y + 4}, Size = {18, 18}
        }
      end
  
      table.insert(graphics, {Type = "Text", Text = "Active", FontSize = fs1, HTextAlign = "Left", Color = Palette.text, Position = {camGX + 12, footerY + 3}, Size = {48, h1}})
      layout["active_camera_name"] = {
        PrettyName = "Cameras~Active Camera", Style = "Text", FontSize = fs1,
        HTextAlign = "Center", Color = Palette.White, Padding = 2, StrokeWidth = 1,
        Position = {camGX + 60, footerY}, Size = {camGW - 72, 26}
      }
  
      -- Camera Router group ----------------------------------------------------
      local trackTop = camGY + camGH + 14
      local tY  = trackTop + 26
      local tY2 = tY + 30
  
      table.insert(graphics, {
        Type = "GroupBox", Text = "Camera Router (Optional)", FontSize = fs1, HTextAlign = "Left",
        Color = Palette.text, StrokeColor = Palette.Black, StrokeWidth = 1,
        CornerRadius = 8, Position = {0, trackTop}, Size = {PLUGIN_W, 92}
      })
      table.insert(graphics, {Type = "Text", Text = "Router", FontSize = fs1, HTextAlign = "Left", Color = Palette.text, Position = {12, tY + 3}, Size = {48, h1}})
      layout["router_select"] = {PrettyName = "Router~Component", Style = "ComboBox", FontSize = fs1, Color = Palette.White, Padding = 2, StrokeWidth = 1, Position = {62, tY}, Size = {PLUGIN_W - 62 - 40, 24}}
      layout["router_found"] = {PrettyName = "Router~Found", Style = "Indicator", Color = Palette.Green, OffColor = {16, 40, 24}, UnlinkOffColor = true, StrokeWidth = 1, Margin = 2, Position = {PLUGIN_W - 28, tY + 3}, Size = {18, 18}}
  
      table.insert(graphics, {Type = "Text", Text = "Output", FontSize = fs1, HTextAlign = "Left", Color = Palette.text, Position = {12, tY2 + 3}, Size = {50, h1}})
      layout["router_output"] = {PrettyName = "Router~Output", Style = "Text", Color = Palette.White, OffColor = Palette.White, UnlinkOffColor = true, FontSize = fs1, HTextAlign = "Center", Padding = 2, StrokeWidth = 1, Position = {66, tY2}, Size = {56, 24}}
      table.insert(graphics, {Type = "Text", Text = "Source", FontSize = fs1, HTextAlign = "Left", Color = Palette.text, Position = {132, tY2 + 3}, Size = {50, h1}})
      layout["tracked_source"] = {PrettyName = "Router~Source", Style = "Text", FontSize = fs1, HTextAlign = "Center", Color = Palette.White, Padding = 2, StrokeWidth = 1, Position = {186, tY2}, Size = {PLUGIN_W - 186 - 12, 24}}
  
    elseif CurrentPage == "Control" then
  
      -- No page title: the native block starts straight into the first group.
      -- Pan / Tilt / Zoom group ------------------------------------------------
      table.insert(graphics, {
        Type = "GroupBox", Text = "Pan / Tilt / Zoom", FontSize = fs1,
        HTextAlign = "Left", Color = Palette.text, StrokeColor = Palette.Black,
        StrokeWidth = 1, CornerRadius = 8,
        Position = {ptzGX, ptzGY}, Size = {ptzGW, ptzGH}
      })
      table.insert(graphics, {
        Type = "Text", Text = "Pan, Tilt,\nand Zoom\nControls", FontSize = fs1,
        HTextAlign = "Right", Color = Palette.text,
        Position = {4, padY}, Size = {65, 102}
      })
  
      -- 3x3 directional pad with an empty centre (matches the QSC layout)
      local padR2, padR3 = padY + padPitch, padY + 2 * padPitch
      local pad = {
        ptz_up_left    = {padX,                  padY},
        ptz_tilt_up    = {padX + padPitch,       padY},
        ptz_up_right   = {padX + 2 * padPitch,   padY},
        ptz_pan_left   = {padX,                  padR2},
        ptz_pan_right  = {padX + 2 * padPitch,   padR2},
        ptz_down_left  = {padX,                  padR3},
        ptz_tilt_down  = {padX + padPitch,       padR3},
        ptz_down_right = {padX + 2 * padPitch,   padR3}
      }
      local ptzPretty = {
        ptz_up_left    = "Pan-Tilt-Zoom~Pan Left / Tilt Up",
        ptz_tilt_up    = "Pan-Tilt-Zoom~Tilt Up",
        ptz_up_right   = "Pan-Tilt-Zoom~Pan Right / Tilt Up",
        ptz_pan_left   = "Pan-Tilt-Zoom~Pan Left",
        ptz_pan_right  = "Pan-Tilt-Zoom~Pan Right",
        ptz_down_left  = "Pan-Tilt-Zoom~Pan Left / Tilt Down",
        ptz_tilt_down  = "Pan-Tilt-Zoom~Tilt Down",
        ptz_down_right = "Pan-Tilt-Zoom~Pan Right / Tilt Down"
      }
      for name, pos in pairs(pad) do
        layout[name] = {
          PrettyName = ptzPretty[name],
          Legend = "", Style = "Button",
          Color = Palette.White, OffColor = Palette.ptz_off, UnlinkOffColor = true,
          Margin = 2, Position = {pos[1], pos[2]}, Size = {hB, hB}
        }
      end
  
      -- Zoom (magnifier icons) -- no column heading, as on the native block
      layout["ptz_zoom_in"]  = {PrettyName = "Pan-Tilt-Zoom~Zoom In",  Legend = "", Style = "Button", Color = Palette.White, OffColor = Palette.ptz_off, UnlinkOffColor = true, Margin = 2, Position = {zoomX, padY},  Size = {hB, hB}}
      layout["ptz_zoom_out"] = {PrettyName = "Pan-Tilt-Zoom~Zoom Out", Legend = "", Style = "Button", Color = Palette.White, OffColor = Palette.ptz_off, UnlinkOffColor = true, Margin = 2, Position = {zoomX, padR2}, Size = {hB, hB}}
  
      -- Home / Privacy (icon + red save, as on the native camera)
      -- Home on the pad's first row, Privacy on its second; labels centred on the
      -- 32pt buttons, so 8px lower.
      local homeY, privY = padY, padR2
      table.insert(graphics, {Type = "Text", Text = "Home",    FontSize = fs1, HTextAlign = "Right", Color = Palette.text, Position = {hpLblX, homeY + 8}, Size = {hpLblW, 16}})
      table.insert(graphics, {Type = "Text", Text = "Privacy", FontSize = fs1, HTextAlign = "Right", Color = Palette.text, Position = {hpLblX, privY + 8}, Size = {hpLblW, 16}})
  
      layout["ptz_home"]     = {PrettyName = "Pan-Tilt-Zoom~Home",         Legend = "",             Style = "Button", Color = Palette.btn_green, OffColor = Palette.green_off, UnlinkOffColor = true, Margin = 2, Position = {hpIconX, homeY}, Size = {hpIcon, 32}}
      layout["home_save"]    = {PrettyName = "Pan-Tilt-Zoom~Save Home",    Legend = "Save\nHome",    FontSize = 9, Style = "Button", Color = Palette.Red, Margin = 2, Position = {hpSaveX, homeY}, Size = {hpSaveW, 32}}
      layout["privacy_load"] = {PrettyName = "Pan-Tilt-Zoom~Privacy Mode", Legend = "",             Style = "Button", Color = Palette.btn_green, OffColor = Palette.gray_off, UnlinkOffColor = true, Margin = 2, Position = {hpIconX, privY}, Size = {hpIcon, 32}}
      layout["privacy_save"] = {PrettyName = "Pan-Tilt-Zoom~Save Privacy", Legend = "Save\nPrivacy", FontSize = 9, Style = "Button", Color = Palette.Red, Margin = 2, Position = {hpSaveX, privY}, Size = {hpSaveW, 32}}
  
      -- Coordinates readout (current ptz.preset position), on its own row above
      -- the toggle rows.
      table.insert(graphics, {Type = "Text", Text = "Coordinates", FontSize = fs1, HTextAlign = "Right", Color = Palette.text, Position = {lblX, coordsY}, Size = {64, 16}})
      layout["coordinates"] = {PrettyName = "Pan-Tilt-Zoom~Coordinates", Style = "Text", FontSize = fsM, HTextAlign = "Center", Color = Palette.White, OffColor = Palette.White, UnlinkOffColor = true, Padding = 1, StrokeWidth = 1, Position = {74, coordsY}, Size = {102, 16}}
  
      -- Two columns of proxied setup rows: toggles on the left, speeds on the
      -- right. Rendered here rather than from CamGroups because this group's
      -- geometry is bespoke (the 3x3 pad sits above it).
      local function PtzLabel(x, y, w, text)
        table.insert(graphics, {Type = "Text", Text = text, FontSize = fs1,
          HTextAlign = "Right", Color = Palette.text, Position = {x, y}, Size = {w, 16}})
      end
      local function PtzBool(name, pretty, y, x)
        layout[name] = {PrettyName = pretty, Legend = "", Style = "Button",
          Color = Palette.btn_green, OffColor = Palette.green_off, UnlinkOffColor = true,
          Margin = 2, Position = {x, y}, Size = {32, 16}}
      end
      local function PtzMeter(name, pretty, y, x, w)
        layout[name] = {PrettyName = pretty, Style = "Text", FontSize = fsM,
          HTextAlign = "Center", Color = Palette.meter_on, OffColor = Palette.meter_off,
          UnlinkOffColor = true, TextColor = Palette.Black, Padding = 2, StrokeWidth = 1,
          Position = {x, y}, Size = {w, 16}}
      end
      local function PtzLed(name, pretty, y, x)
        layout[name] = {PrettyName = pretty, Style = "Indicator", Color = Palette.green_on,
          OffColor = Palette.green_off, UnlinkOffColor = true, StrokeWidth = 1, Margin = 3,
          Position = {x, y}, Size = {16, 16}}
      end
  
      -- Left column of toggles, and a separate right column of speed meters that
      -- starts two rows higher -- the speeds run alongside the pad, so they do not
      -- share a row grid with the toggles.
      local spdLblX, spdLblW = 179, 83
      local spdX, spdW       = 265, 166
      local spdRow0          = 106
  
      local r = ptzRow0
      PtzLabel(lblX, r, lblW, "Speed By Zoom");  PtzBool("setup.speed.by.zoom", "Pan-Tilt-Zoom~Speed By Zoom", r, ctlX)
      r = r + ptzRowH
      PtzLabel(lblX, r, lblW, "Recalibrate PTZ")
      layout["ptz.recalibrate"] = {PrettyName = "Pan-Tilt-Zoom~Recalibrate PTZ", Legend = "", Style = "Button",
        Color = Palette.White, OffColor = Palette.gray_off, UnlinkOffColor = true,
        Margin = 2, Position = {ctlX, r}, Size = {32, 16}}
      r = r + ptzRowH
      PtzLabel(lblX, r, lblW, "Ceiling Mount");  PtzBool("setup.ceiling.mount", "Pan-Tilt-Zoom~Ceiling Mount", r, ctlX)
      r = r + ptzRowH
      PtzLabel(lblX, r, lblW, "Is Moving");      PtzLed("is_moving", "Pan-Tilt-Zoom~Is Moving", r, ctlX)
      r = r + ptzRowH
      PtzLabel(lblX, r, lblW, "Move Completed"); PtzLed("move.completed", "Pan-Tilt-Zoom~Move Completed", r, ctlX)
  
      local SPEEDS = {
        {"setup.pan.speed",            "Pan-Tilt-Zoom~Pan Speed",    "Pan Speed"},
        {"setup.tilt.speed",           "Pan-Tilt-Zoom~Tilt Speed",   "Tilt Speed"},
        {"setup.zoom.speed",           "Pan-Tilt-Zoom~Zoom Speed",   "Zoom Speed"},
        {"aaaa.setup.snapshot.speed",  "Pan-Tilt-Zoom~Recall Speed", "Recall Speed"}
      }
      for i, s in ipairs(SPEEDS) do
        local sy = spdRow0 + (i - 1) * ptzRowH
        PtzLabel(spdLblX, sy, spdLblW, s[3])
        PtzMeter(s[1], s[2], sy, spdX, spdW)
      end
  
      -- Focus group -------------------------------------------------------------
      local focusTop = 256                   -- reports as 260
      local focusGH  = 94
      table.insert(graphics, {
        Type = "GroupBox", Text = "Focus", FontSize = fs1, HTextAlign = "Left",
        Color = Palette.text, StrokeColor = Palette.Black, StrokeWidth = 1,
        CornerRadius = 8, Position = {ptzGX, focusTop}, Size = {PLUGIN_W, focusGH}
      })
      -- Mode cluster: AF under "Auto", In/Out under "Manual", as on the native
      -- block. These buttons used to sit beside Zoom in the PTZ group.
      -- Mode / In / Out head their buttons; Auto / Manual caption them.
      local afX, inX, outX = 74, 109, 144
      local fHeadY, fBtnY, fCapY = 276, 295, 330
      table.insert(graphics, {Type = "Text", Text = "Mode", FontSize = fs1, HTextAlign = "Right",  Color = Palette.text, Position = {71,   fHeadY}, Size = {35, 16}})
      table.insert(graphics, {Type = "Text", Text = "In",   FontSize = fs1, HTextAlign = "Center", Color = Palette.text, Position = {inX,  fHeadY}, Size = {hB, 16}})
      table.insert(graphics, {Type = "Text", Text = "Out",  FontSize = fs1, HTextAlign = "Center", Color = Palette.text, Position = {outX, fHeadY}, Size = {hB, 16}})
      layout["ptz_af"]        = {PrettyName = "Focus~AF",  Legend = "AF", Style = "Button", Color = Palette.White, OffColor = Palette.ptz_off, UnlinkOffColor = true, Margin = 2, Position = {afX,  fBtnY}, Size = {hB, hB}}
      layout["ptz_focus_in"]  = {PrettyName = "Focus~In",  Legend = "",   Style = "Button", Color = Palette.White, OffColor = Palette.ptz_off, UnlinkOffColor = true, Margin = 2, Position = {inX,  fBtnY}, Size = {hB, hB}}
      layout["ptz_focus_out"] = {PrettyName = "Focus~Out", Legend = "",   Style = "Button", Color = Palette.White, OffColor = Palette.ptz_off, UnlinkOffColor = true, Margin = 2, Position = {outX, fBtnY}, Size = {hB, hB}}
      table.insert(graphics, {Type = "Text", Text = "Auto",   FontSize = fs1, HTextAlign = "Center", Color = Palette.text, Position = {afX, fCapY}, Size = {32, 16}})
      table.insert(graphics, {Type = "Text", Text = "Manual", FontSize = fs1, HTextAlign = "Center", Color = Palette.text, Position = {inX, fCapY}, Size = {67, 16}})
  
      -- Focus option boxes are 160x16 at x=262, labels 80 wide at x=179.
      local foX, foW = 262, 160
      local function FocusLabel(y, text)
        table.insert(graphics, {Type = "Text", Text = text, FontSize = fs1,
          HTextAlign = "Right", Color = Palette.text, Position = {179, y}, Size = {80, 16}})
      end
      FocusLabel(276, "Manual Speed")
      PtzMeter("setup.focus.speed", "Focus~Manual Speed", 276, foX, foW)
      FocusLabel(295, "AF Sensitivity")
      layout["setup.focus.sensitivity"] = {PrettyName = "Focus~AF Sensitivity", Style = "ComboBox",
        FontSize = fsM, HTextAlign = "Center", Color = Palette.White, Padding = 2,
        StrokeWidth = 1, Position = {foX, 295}, Size = {foW, 16}}
      FocusLabel(314, "AF Zone")
      layout["setup.focus.zone"] = {PrettyName = "Focus~AF Zone", Style = "ComboBox",
        FontSize = fsM, HTextAlign = "Center", Color = Palette.White, Padding = 2,
        StrokeWidth = 1, Position = {foX, 314}, Size = {foW, 16}}
  
      -- Tracks the lowest group so far, so Preview follows whatever precedes it.
      local pageBottom = focusTop + focusGH
  
      -- Presets group (right column, under the PTZ block; single row of presets)
      if NumPresets > 0 then
        local presetGX  = ptzGX
        local presetTop = focusTop + focusGH + 12
        local btnX0     = presetGX + 12
        local btnRow    = presetTop + 28
        local presetGW  = PLUGIN_W
        -- Wrap onto as many rows as the 435px width needs.
        local perRow    = math.max(1, math.floor((presetGW - 24) / hB))
        local presetRows = math.ceil(NumPresets / perRow)
        local presetGH  = (btnRow + presetRows * hB) - presetTop + 10
  
        table.insert(graphics, {
          Type = "GroupBox", Text = "Presets", FontSize = fs1, HTextAlign = "Left",
          Color = Palette.text, StrokeColor = Palette.Black, StrokeWidth = 1,
          CornerRadius = 8, Position = {ptzGX, presetTop}, Size = {presetGW, presetGH}
        })
        table.insert(graphics, {Type = "Text", Text = "tap = recall   hold = save", FontSize = fs1, HTextAlign = "Center", Color = Palette.Gray, Position = {presetGX + 80, presetTop + 2}, Size = {presetGW - 240, h1}})
        table.insert(graphics, {Type = "Text", Text = "Preset Saved", FontSize = fs1, HTextAlign = "Right", Color = Palette.text, Position = {presetGX + presetGW - 150, presetTop + 2}, Size = {120, h1}})
        layout["preset_saved"] = {PrettyName = "Presets~Saved", Style = "Indicator", Color = Palette.cti_amber, OffColor = {60, 46, 16}, UnlinkOffColor = true, StrokeWidth = 1, Margin = 2, Position = {presetGX + presetGW - 26, presetTop + 4}, Size = {18, 18}}
  
        for p = 1, NumPresets do
          local col = (p - 1) % perRow
          local row = math.floor((p - 1) / perRow)
          layout[fmt("preset_%03d", p)] = {
            PrettyName = fmt("Presets~%d", p), Legend = tostring(p),
            Style = "Button", Color = Palette.green_on, OffColor = Palette.ptz_off,
            UnlinkOffColor = true, Margin = 3,
            Position = {btnX0 + col * hB, btnRow + row * hB}, Size = {hB, hB}
          }
        end
        pageBottom = presetTop + presetGH
      end
  
      -- Camera Preview -----------------------------------------------------------
      -- A text field presented as a MediaDisplay; the runtime feeds it the
      -- camera's own preview string.
      local previewTop = pageBottom + 12
      local previewGH  = 204
      table.insert(graphics, {
        Type = "GroupBox", Text = "Camera Preview", FontSize = fs1, HTextAlign = "Left",
        Color = Palette.text, StrokeColor = Palette.Black, StrokeWidth = 1,
        CornerRadius = 8, Position = {ptzGX, previewTop}, Size = {PLUGIN_W, previewGH}
      })
      local previewW, previewH = 320, 180
      layout["preview"] = {
        PrettyName = "Preview", Style = "Text", PresentationType = "Media Display",
        Color = Palette.ro_grey, OffColor = Palette.ro_grey, UnlinkOffColor = true,
        -- Centred: a 320-wide field cannot start at x=180 inside a 435 group.
        Position = {ptzGX + math.floor((PLUGIN_W - previewW) / 2), previewTop + 20},
        Size = {previewW, previewH}
      }
  
    else
  
      -- Every remaining page (Imaging, Auto Framing, IP Streams, Status) is
      -- rendered entirely from the registry.
      -- Group boxes and rows are rendered from the CamCtls registry, so the page
      -- is defined by data rather than by positions repeated per control.
      local GRP_W   = 433   -- group boxes on these pages are 433 wide
      local rowStep = 19
      local ctlH    = 16
      -- Two-column grid: label then a 128-wide control in each half.
      local COL = {
        {lblX = 4,   lblW = 64, ctlX = 71,  ctlW = 128},
        {lblX = 202, lblW = 96, ctlX = 301, ctlW = 128}
      }
      local lblW1 = 240     -- label width in a single-column group
  
      local function PlaceLabel(x, y, w, text, h)
        table.insert(graphics, {
          Type = "Text", Text = text, FontSize = fs1, HTextAlign = "Right",
          Color = Palette.text, Position = {x, y}, Size = {w, h or 16}
        })
      end
  
      -- int/float render as a text box over a meter fill; ro mirrors the camera's
      -- own formatted string and is drawn dimmed, as the native block draws a
      -- value you cannot set.
      local function PlaceCtl(d, x, y, w)
        if d.kind == "int" or d.kind == "float" then
          layout[d.name] = {PrettyName = d.pretty, Style = "Text", FontSize = fsM,
            HTextAlign = "Center", Color = Palette.meter_on, OffColor = Palette.meter_off,
            UnlinkOffColor = true, TextColor = Palette.Black, Padding = 2, StrokeWidth = 1,
            Position = {x, y}, Size = {w, ctlH}}
        elseif d.kind == "enum" then
          layout[d.name] = {PrettyName = d.pretty, Style = "ComboBox", FontSize = fsM,
            HTextAlign = "Center", Color = Palette.White, Padding = 2, StrokeWidth = 1,
            Position = {x, y}, Size = {w, ctlH}}
        elseif d.kind == "ro" then
          local fill = d.fill or Palette.White
          layout[d.name] = {PrettyName = d.pretty, Style = "Text", FontSize = fsM,
            HTextAlign = "Center", Color = fill, OffColor = fill,
            UnlinkOffColor = true, TextColor = Palette.Black, Padding = 2, StrokeWidth = 1,
            Position = {x, y}, Size = {w, ctlH}}
        elseif d.kind == "text" then
          layout[d.name] = {PrettyName = d.pretty, Style = "Text", FontSize = fsM,
            HTextAlign = "Center", Color = Palette.White, OffColor = Palette.White,
            UnlinkOffColor = true, Padding = 2, StrokeWidth = 1,
            Position = {x, y}, Size = {w, ctlH}}
        elseif d.kind == "status" then
          layout[d.name] = {PrettyName = d.pretty, Style = "Text", FontSize = fsM,
            HTextAlign = "Center", Color = d.fill or Palette.White,
            TextColor = Palette.Black, Padding = 2, StrokeWidth = 1,
            Position = {x, y}, Size = {w, d.h or ctlH}}
        elseif d.kind == "led" then
          layout[d.name] = {PrettyName = d.pretty, Style = "Indicator",
            Color = d.fill or Palette.green_on, OffColor = d.offFill or Palette.green_off,
            UnlinkOffColor = true, StrokeWidth = 1, Margin = 3,
            Position = {x, y}, Size = {16, 16}}
        elseif d.kind == "bool" then
          -- legendOff is the starting caption; the runtime swaps it with the state.
          layout[d.name] = {PrettyName = d.pretty, Legend = d.legend or d.legendOff or "",
            FontSize = fsM, Style = "Button",
            Color = d.fill or Palette.btn_green, OffColor = d.offFill or Palette.green_off,
            UnlinkOffColor = true,
            Margin = 2, Position = {x, y}, Size = {d.w or 32, ctlH}}
        elseif d.kind == "statetrig" then
          layout[d.name] = {PrettyName = d.pretty, Legend = d.legend or "", FontSize = fsM,
            Style = "Button", Color = d.fill or Palette.btn_green,
            OffColor = d.offFill or Palette.gray_off, UnlinkOffColor = true,
            Margin = 2, Position = {x, y}, Size = {d.w or 32, d.h or ctlH}}
        elseif d.kind == "trigger" then
          layout[d.name] = {PrettyName = d.pretty, Legend = "", Style = "Button",
            Color = Palette.White, OffColor = Palette.gray_off, UnlinkOffColor = true,
            Margin = 2, Position = {x, y}, Size = {math.min(w, 32), ctlH}}
        end
      end
  
      -- Page-level trigger sits above the first group, as on the native block:
      -- a 400-wide label on row 0 with a 32x16 button at x=403.
      local y = 0
      for _, t in ipairs(CamPageTriggers) do
        if t.page == CurrentPage then
          PlaceLabel(0, y, 400, t.label)
          layout[t.name] = {PrettyName = t.pretty, Legend = "", Style = "Button",
            Color = Palette.White, OffColor = Palette.gray_off, UnlinkOffColor = true,
            Margin = 2, Position = {403, y}, Size = {32, 16}}
          y = y + 16
        end
      end
  
      -- Paired-column geometry, used by the IP Streams table. A pairs group
      -- carries its own columns; this is only the fallback.
      local PAIR_DEFAULT = {{ctlX = 107, ctlW = 120}, {ctlX = 272, ctlW = 160}}
      local function PairCol(g, c) return (g.cols or PAIR_DEFAULT)[c] or PAIR_DEFAULT[c] end
  
      for _, g in ipairs(CamGroups) do
        if g.page == CurrentPage then
          -- A group with measured y/h/w uses them; the rest stack automatically.
          local gy = g.y or y
          local gh = g.h or (11 + g.rows * rowStep)
          table.insert(graphics, {
            Type = "GroupBox", Text = g.name, FontSize = fs1, HTextAlign = "Left",
            Color = Palette.text, StrokeColor = Palette.Black, StrokeWidth = 1,
            CornerRadius = 8, Position = {0, gy}, Size = {g.w or GRP_W, gh}
          })
          -- Column headings above a paired table.
          if g.headers then
            for c, text in ipairs(g.headers) do
              local cc = PairCol(g, c)
              -- A heading may be narrower than its column (Preview Stream sits
              -- beside the Enable button).
              table.insert(graphics, {
                Type = "Text", Text = text, FontSize = fs1,
                HTextAlign = "Center", Color = Palette.text,
                Position = {cc.hdrX or cc.ctlX, gy + 20}, Size = {cc.hdrW or cc.ctlW, 16}
              })
            end
          end
          for _, d in ipairs(CamCtls) do
            if d.page == CurrentPage and d.group == g.name then
              -- dy nudges a control off its row baseline (the Status LEDs do not
              -- sit level with their labels).
              local ry = gy + 20 + (d.row - 1) * rowStep + (d.dy or 0)
              if g.style == "pairs" then
                local cc = PairCol(g, d.col)
                if d.rowlabel then PlaceLabel(4, ry, g.lblW or 100, d.rowlabel) end
                PlaceCtl(d, d.x or cc.ctlX, ry, d.w or cc.ctlW)
              elseif g.style == "cols1" then
                local c = (g.cols and g.cols[1]) or
                          {lblX = 4, lblW = lblW1, ctlX = 4 + lblW1 + 12,
                           ctlW = GRP_W - (4 + lblW1 + 12) - 8}
                if d.label ~= "" then PlaceLabel(c.lblX, ry, c.lblW, d.label, d.lblH) end
                PlaceCtl(d, d.x or c.ctlX, ry, d.w or c.ctlW)
              else
                -- A group may override the default column geometry.
                local c = (g.cols or COL)[d.col]
                if d.label ~= "" then PlaceLabel(c.lblX, ry, c.lblW, d.label, d.lblH) end
                PlaceCtl(d, d.x or c.ctlX, ry, d.w or c.ctlW)
              end
            end
          end
          -- Static captions that belong to a row but have no control of their own.
          for _, t2 in ipairs(CamTexts) do
            if t2.page == CurrentPage and t2.group == g.name then
              table.insert(graphics, {
                Type = "Text", Text = t2.text, FontSize = t2.fs or fs1,
                HTextAlign = t2.align or "Left", Color = Palette.text,
                Position = {t2.x, gy + 20 + (t2.row - 1) * rowStep}, Size = {t2.w, 16}
              })
            end
          end
          y = gy + gh + 12
        end
      end
  
    end
  return layout, graphics
end

-- Start event-based logic
if Controls then
    local fmt = string.format
    local CameraCount = Properties["Camera Count"].Value
    local NumPresets  = Properties["Num Presets"].Value
    local DebugMode   = Properties["Debug Print"].Value
    local HoldTime    = Properties["Hold to Save (s)"].Value
  
    local function dbg(...)
      if DebugMode ~= "None" then print("[CamCtrl]", ...) end
    end
  
    local ok_rj, rapidjson = pcall(require, "rapidjson")
    if not ok_rj or rapidjson == nil then
      rapidjson = rawget(_G, "rapidjson")
      ok_rj = (rapidjson ~= nil)
    end
  
    -- Each logical button maps to a native QSC camera control name.
    local PTZ_MAP = {
      ptz_pan_left  = "pan.left",
      ptz_pan_right = "pan.right",
      ptz_tilt_up   = "tilt.up",
      ptz_tilt_down = "tilt.down",
      ptz_zoom_in   = "zoom.in",
      ptz_zoom_out  = "zoom.out",
      ptz_focus_in  = "focus.far",   -- Focus In  = focus.far
      ptz_focus_out = "focus.near"   -- Focus Out = focus.near
    }
  
    -- Diagonals use the dedicated diagonal control, falling back to driving the
    -- two cardinal directions together if a camera lacks it.
    local DIAG_MAP = {
      ptz_up_left    = {ctl = "pan.left.tilt.up",    fallback = {"ptz_tilt_up",   "ptz_pan_left"}},
      ptz_up_right   = {ctl = "pan.right.tilt.up",   fallback = {"ptz_tilt_up",   "ptz_pan_right"}},
      ptz_down_left  = {ctl = "pan.left.tilt.down",  fallback = {"ptz_tilt_down", "ptz_pan_left"}},
      ptz_down_right = {ctl = "pan.right.tilt.down", fallback = {"ptz_tilt_down", "ptz_pan_right"}}
    }
  
    -- One-shot trigger buttons.
    local TRIGGER_MAP = {
      ptz_home     = "preset.home.load",
      home_save    = "preset.home.save.trigger",
      privacy_save = "preset.private.save.trigger"
    }
  
    -- Positions are read/written as a coordinate string on this control.
    local COORD_CTRL = "ptz.preset"
    -- Privacy recall toggles this Boolean.
    local PRIVACY_TOGGLE = "toggle.privacy"
    -- Auto white balance mode (a ComboBox on the native camera).
    local WB_MODE = "wb.awb.mode"
    -- The camera normally reports its own Choices; fall back to the known modes so
    -- the combo is never empty on a model that does not.
    local WB_MODE_CHOICES = {"Auto", "Manual", "One Push"}
  
    local Proxies = {}      -- [slot] = component proxy or nil
    local ActiveIndex = 1
    local Suppress = 0      -- depth counter guarding re-entrant radio writes
  
    local UpdatePresetHighlights    -- forward declaration (defined below)
    local PresetFbSuppress = false   -- guard while writing preset feedback state
    local CoordFbSuppress = false    -- guard while writing the coordinates readout
    local PrivacyFbSuppress = false  -- guard while writing the privacy toggle state
    local CamFbSuppress = {}         -- [name] = true while writing that control's feedback
    local CamBound = {}              -- [name] = camera currently subscribed for it
  
    local RouterProxy = nil         -- bound router component, or nil
    local RouterBoundCtl = nil      -- the router control we are subscribed to
    local RouterCtlNames = {}       -- control names present on the bound router
    local RouterSelCtl = nil        -- resolved output-select control for the tracked output
    local RouterSrcCtl = nil        -- resolved routed-source-name control for the tracked output
    local RouteActiveToRouter       -- forward declaration (defined below)
    local RouterApplying = false    -- guard: active change originated from the router
  
    local function ActiveCam()
      return Proxies[ActiveIndex]
    end
  
    local function ActiveCamName()
      local sel = Controls[fmt("camera_select_%03d", ActiveIndex)]
      return (sel and sel.String) or ""
    end
  
    local function HasControl(cam, name)
      local ok, exists = pcall(function() return cam[name] ~= nil end)
      return ok and exists
    end
  
    -- Write a boolean to a control on the active camera, if it exists.
    local function SetCtl(name, value)
      local cam = ActiveCam()
      if cam == nil then dbg("no active camera") return end
      if not HasControl(cam, name) then dbg("target lacks", name) return end
      local ok, err = pcall(function() cam[name].Boolean = value end)
      if not ok then dbg("error setting", name, err) end
    end
  
    local function PulseCtl(name)
      SetCtl(name, true)
      SetCtl(name, false)
    end
  
    local function DriveDiagonal(def, value)
      local cam = ActiveCam()
      if cam == nil then return end
      if HasControl(cam, def.ctl) then
        pcall(function() cam[def.ctl].Boolean = value end)
      else
        for _, logical in ipairs(def.fallback) do
          SetCtl(PTZ_MAP[logical], value)
        end
      end
    end
  
    -- Reflect the active camera's privacy mode on the toggle button.
    local function UpdatePrivacyNow()
      local cam = ActiveCam()
      local v = false
      if cam and HasControl(cam, PRIVACY_TOGGLE) then
        pcall(function() v = cam[PRIVACY_TOGGLE].Boolean end)
      end
      local ctl = Controls["privacy_load"]
      if ctl then
        PrivacyFbSuppress = true
        if ctl.Boolean ~= v then ctl.Boolean = v end
        PrivacyFbSuppress = false
      end
    end
  
    -- Mirror one registry control in from the active camera. Every write is
    -- conditional, so a settled control emits no events of its own.
    local function MirrorIn(d)
      local ctl = Controls[d.name]
      if ctl == nil then return end
      local cam = ActiveCam()
      local present = (cam ~= nil) and HasControl(cam, d.name)
      CamFbSuppress[d.name] = true
      if present then
        if d.kind == "int" or d.kind == "float" then
          local v; pcall(function() v = cam[d.name].Value end)
          if v ~= nil and ctl.Value ~= v then ctl.Value = v end
        elseif d.kind == "bool" then
          local v; pcall(function() v = cam[d.name].Boolean end)
          if v ~= nil and ctl.Boolean ~= v then ctl.Boolean = v end
          -- Some toggles caption themselves with their state (SDI/HDMI, A/B).
          if v ~= nil and d.legendOn ~= nil then
            local want = v and d.legendOn or d.legendOff
            if ctl.Legend ~= want then ctl.Legend = want end
          end
        elseif d.kind == "enum" then
          local ch, s
          pcall(function() ch = cam[d.name].Choices end)
          pcall(function() s  = cam[d.name].String end)
          if (ch == nil or #ch == 0) and d.name == WB_MODE then ch = WB_MODE_CHOICES end
          ctl.Choices = ch or {}
          if s ~= nil and ctl.String ~= s then ctl.String = s end
        elseif d.kind == "ro" or d.kind == "text" or d.kind == "media" then
          -- Aperture, Shutter and friends already arrive formatted (f/1.8, 1/60).
          local s; pcall(function() s = cam[d.name].String end)
          if s ~= nil and ctl.String ~= s then ctl.String = s end
        elseif d.kind == "led" then
          local v; pcall(function() v = cam[d.name].Boolean end)
          if v ~= nil and ctl.Boolean ~= v then ctl.Boolean = v end
        elseif d.kind == "status" then
          local s, v
          pcall(function() s = cam[d.name].String end)
          pcall(function() v = cam[d.name].Value end)
          if s ~= nil and ctl.String ~= s then ctl.String = s end
          if v ~= nil and ctl.Value ~= v then ctl.Value = v end
        elseif d.kind == "statetrig" then
          -- The camera's State Trigger pattern: lit state lives on a .state
          -- sibling when there is one, otherwise on the control itself.
          local v
          local st = d.name .. ".state"
          if HasControl(cam, st) then
            pcall(function() v = cam[st].Boolean end)
          else
            pcall(function() v = cam[d.name].Boolean end)
          end
          if v ~= nil and ctl.Boolean ~= v then ctl.Boolean = v end
        end
      end
      -- Grey-out follows the camera. A control it does not expose, and every
      -- control while no camera is bound, reads disabled -- which is how the
      -- native block shows a setting that does not apply.
      local want = true
      if present then
        local ok, v = pcall(function() return cam[d.name].IsDisabled end)
        if ok and v ~= nil then want = v else want = false end
      end
      if ctl.IsDisabled ~= want then ctl.IsDisabled = want end
      CamFbSuppress[d.name] = false
    end
  
    local function MirrorAll()
      for _, d in ipairs(CamCtls) do MirrorIn(d) end
    end
  
    -- IsDisabled raises no event, so re-read it periodically to catch grey-out
    -- driven by camera controls the plugin has not subscribed to.
    local function RefreshDisabled()
      local cam = ActiveCam()
      for _, d in ipairs(CamCtls) do
        local ctl = Controls[d.name]
        if ctl ~= nil then
          local want = true
          if cam ~= nil and HasControl(cam, d.name) then
            local ok, v = pcall(function() return cam[d.name].IsDisabled end)
            if ok and v ~= nil then want = v else want = false end
          end
          if ctl.IsDisabled ~= want then ctl.IsDisabled = want end
        end
      end
    end
  
    -- IsDisabled raises no event, so poll slowly to catch changes driven by
    -- controls the plugin has not subscribed to.
    local DisabledTimer = Timer.New()
    DisabledTimer.EventHandler = function() RefreshDisabled() end
  
    -- ===== Preset store (per camera component name) =====
    -- Persisted as JSON in the hidden "preset_store" control so it survives core
    -- restarts and design saves. Shape: { [cameraName] = { ["0"]="coord", ... } }
    local PresetStore = {}
  
    local function LoadStore()
      PresetStore = {}
      local raw = Controls["preset_store"] and Controls["preset_store"].String or ""
      if raw ~= "" and ok_rj then
        local ok, decoded = pcall(rapidjson.decode, raw)
        if ok and type(decoded) == "table" then PresetStore = decoded end
      end
    end
  
    local function SaveStore()
      if not (Controls["preset_store"] and ok_rj) then return end
      local ok, encoded = pcall(rapidjson.encode, PresetStore)
      if ok then Controls["preset_store"].String = encoded end
    end
  
    -- Preset-saved indicator: flash high for 3s on every save.
    local PresetSavedTimer = Timer.New()
    PresetSavedTimer.EventHandler = function()
      PresetSavedTimer:Stop()
      local ctl = Controls["preset_saved"]
      if ctl and ctl.Boolean then ctl.Boolean = false end
    end
    local function FlashPresetSaved()
      local ctl = Controls["preset_saved"]
      if ctl and not ctl.Boolean then ctl.Boolean = true end
      PresetSavedTimer:Start(3)
    end
  
    -- Presets are keyed by the camera's *source* identity, not the component
    -- name: a USB bridge reports its connected camera in "peripheral.camera.source",
    -- so presets follow the physical camera. Native cameras key on their own name.
    local function ActiveCamKey()
      local cam = ActiveCam()
      if cam ~= nil and HasControl(cam, "peripheral.camera.source") then
        local s
        pcall(function() s = cam["peripheral.camera.source"].String end)
        if s ~= nil and s ~= "" then return s end
      end
      return ActiveCamName()
    end
  
    -- Ensure a preset bank exists for the active camera (default "0 0 0").
    local function CheckCamera()
      local key = ActiveCamKey()
      if key == "" then return end
      local bank = PresetStore[key]
      if bank == nil then
        bank = {}
        PresetStore[key] = bank
      end
      local changed = false
      for p = 1, NumPresets do
        if bank[tostring(p)] == nil then bank[tostring(p)] = "0 0 0"; changed = true end
      end
      if changed then SaveStore() end
    end
  
    -- Tap: recall the stored position.
    local function PresetRecallTap(p)
      local cam = ActiveCam()
      if cam == nil or not HasControl(cam, COORD_CTRL) then return end
      local key = ActiveCamKey()
      local coord = PresetStore[key] and PresetStore[key][tostring(p)]
      if coord ~= nil then
        pcall(function() cam[COORD_CTRL].String = coord end)
        dbg("recall preset", p, key, coord)
      end
    end
  
    -- Hold: store the current position.
    local function PresetHoldSave(p)
      local cam = ActiveCam()
      if cam == nil or not HasControl(cam, COORD_CTRL) then return end
      CheckCamera()
      local key = ActiveCamKey()
      local coord
      pcall(function() coord = cam[COORD_CTRL].String end)
      if coord ~= nil and PresetStore[key] ~= nil then
        PresetStore[key][tostring(p)] = coord
        SaveStore()
        dbg("save preset", p, key, coord)
      end
      FlashPresetSaved()
      if UpdatePresetHighlights then UpdatePresetHighlights() end
    end
  
    local function UpdateActiveName()
      local ctl = Controls["active_camera_name"]
      local want = ActiveCamName()
      if ctl and ctl.String ~= want then ctl.String = want end
    end
  
    -- Active-camera feedback: Is Moving LED, Coordinates readout, and preset
    -- recall highlighting all follow the currently selected camera.
    local MovingBoundCam = nil
    local CoordBoundCam = nil
    local SrcBoundCam = nil
    local PrivBoundCam = nil
  
    local function UpdateMovingNow()
      local cam = ActiveCam()
      local v = false
      if cam and HasControl(cam, "is.moving") then
        pcall(function() v = cam["is.moving"].Boolean end)
      end
      local ctl = Controls["is_moving"]
      if ctl and ctl.Boolean ~= v then ctl.Boolean = v end
    end
  
    local function CurrentCoords()
      local cam = ActiveCam()
      if cam and HasControl(cam, COORD_CTRL) then
        local s
        local ok = pcall(function() s = cam[COORD_CTRL].String end)
        if ok then return s end
      end
      return nil
    end
  
    local function UpdateCoordinatesNow()
      if Controls["coordinates"] then
        local want = CurrentCoords() or ""
        CoordFbSuppress = true
        if Controls["coordinates"].String ~= want then Controls["coordinates"].String = want end
        CoordFbSuppress = false
      end
    end
  
    -- Light the LED of each preset whose stored coordinate equals the live position.
    UpdatePresetHighlights = function()
      local cur = CurrentCoords()
      local store = PresetStore[ActiveCamKey()] or {}
      PresetFbSuppress = true
      for p = 1, NumPresets do
        local btn = Controls[fmt("preset_%03d", p)]
        if btn ~= nil then
          local saved = store[tostring(p)]
          local want = (cur ~= nil and cur ~= "" and saved ~= nil and saved ~= "" and saved ~= "0 0 0" and saved == cur)
          -- conditional for the same reason as the slot radio: a redundant write
          -- can echo back as an event and restart this update
          if btn.Boolean ~= want then btn.Boolean = want end
        end
      end
      PresetFbSuppress = false
    end
  
    local function BindActiveFeedback()
      if MovingBoundCam ~= nil and HasControl(MovingBoundCam, "is.moving") then
        pcall(function() MovingBoundCam["is.moving"].EventHandler = nil end)
      end
      MovingBoundCam = nil
      if CoordBoundCam ~= nil and HasControl(CoordBoundCam, COORD_CTRL) then
        pcall(function() CoordBoundCam[COORD_CTRL].EventHandler = nil end)
      end
      CoordBoundCam = nil
      if SrcBoundCam ~= nil and HasControl(SrcBoundCam, "peripheral.camera.source") then
        pcall(function() SrcBoundCam["peripheral.camera.source"].EventHandler = nil end)
      end
      SrcBoundCam = nil
      if PrivBoundCam ~= nil and HasControl(PrivBoundCam, PRIVACY_TOGGLE) then
        pcall(function() PrivBoundCam[PRIVACY_TOGGLE].EventHandler = nil end)
      end
      PrivBoundCam = nil
      for _, d in ipairs(CamCtls) do
        local prev = CamBound[d.name]
        if prev ~= nil and HasControl(prev, d.name) then
          pcall(function() prev[d.name].EventHandler = nil end)
        end
        CamBound[d.name] = nil
      end
      local cam = ActiveCam()
      if cam ~= nil then
        if HasControl(cam, "peripheral.camera.source") then
          pcall(function()
            cam["peripheral.camera.source"].EventHandler = function()
              CheckCamera()
              UpdatePresetHighlights()
            end
          end)
          SrcBoundCam = cam
        end
        if HasControl(cam, PRIVACY_TOGGLE) then
          pcall(function()
            cam[PRIVACY_TOGGLE].EventHandler = function() UpdatePrivacyNow() end
          end)
          PrivBoundCam = cam
        end
        -- Subscribe to every registry control on this camera only. An enum is a
        -- mode control, and a mode change is what drives the camera's grey-out
        -- logic, so re-read the whole page when one changes.
        for _, d in ipairs(CamCtls) do
          if d.kind ~= "trigger" and HasControl(cam, d.name) then
            pcall(function()
              cam[d.name].EventHandler = function()
                if d.kind == "enum" then MirrorAll() else MirrorIn(d) end
              end
            end)
            CamBound[d.name] = cam
          end
        end
        if HasControl(cam, "is.moving") then
          pcall(function()
            cam["is.moving"].EventHandler = function(ctl)
              local out = Controls["is_moving"]
              if out and out.Boolean ~= ctl.Boolean then out.Boolean = ctl.Boolean end
            end
          end)
          MovingBoundCam = cam
        end
        if HasControl(cam, COORD_CTRL) then
          pcall(function()
            cam[COORD_CTRL].EventHandler = function()
              UpdateCoordinatesNow()
              UpdatePresetHighlights()
            end
          end)
          CoordBoundCam = cam
        end
      end
      UpdateMovingNow()
      UpdateCoordinatesNow()
      UpdatePrivacyNow()
      MirrorAll()
      CheckCamera()
      UpdatePresetHighlights()
    end
  
    local function RebuildProxy(i)
      local sel = Controls[fmt("camera_select_%03d", i)]
      local found = Controls[fmt("camera_found_%03d", i)]
      local name = sel and sel.String or ""
      if name ~= "" then
        local ok, comp = pcall(Component.New, name)
        if ok and comp ~= nil then
          Proxies[i] = comp
          if found and not found.Boolean then found.Boolean = true end
          dbg("bound slot", i, "->", name)
          return
        end
      end
      Proxies[i] = nil
      if found and found.Boolean then found.Boolean = false end
    end
  
    local function DiscoverCameras()
      local list = {}
      local ok, comps = pcall(Component.GetComponents)
      if not ok or comps == nil then
        dbg("Component.GetComponents failed")
        return list
      end
      for _, c in ipairs(comps) do
        local isCam = false
        if type(c.Type) == "string" then
          local t = string.lower(c.Type)
          if string.find(t, "camera", 1, true) or string.find(t, "uvc", 1, true) then isCam = true end
        end
        if not isCam then
          local ok2, ctrls = pcall(function() return Component.GetControls(Component.New(c.Name)) end)
          if ok2 and ctrls ~= nil then
            for _, ctl in ipairs(ctrls) do
              local n = ctl.Name
              if n == "pan.left" or n == "tilt.up"
                 or n == "ptz.preset" or n == "peripheral.camera.source" then
                isCam = true
                break
              end
            end
          end
        end
        if isCam then table.insert(list, c.Name) end
      end
      table.sort(list)
      dbg("found", #list, "cameras")
      return list
    end
  
    local function RefreshCameraLists()
      local list = DiscoverCameras()
      for i = 1, CameraCount do
        local sel = Controls[fmt("camera_select_%03d", i)]
        if sel ~= nil then
          local choices = {}
          for _, n in ipairs(list) do table.insert(choices, n) end
          local cur = sel.String
          if cur ~= nil and cur ~= "" then
            local present = false
            for _, n in ipairs(choices) do if n == cur then present = true break end end
            if not present then table.insert(choices, cur) end
          end
          sel.Choices = choices
          RebuildProxy(i)
        end
      end
      UpdateActiveName()
    end
  
    -- Drive the slot radio so exactly one button is lit. Every write is
    -- conditional: Q-Sys fires EventHandler on script writes, so an
    -- unconditional write re-triggers this radio and, when Q-Sys delivers that
    -- event after the Suppress window closes, the handler fights back and two
    -- slots latch on. Writing only on change means a settled radio emits no
    -- events at all, which is what makes it converge.
    local function WriteActiveButtons(i)
      Suppress = Suppress + 1
      for j = 1, CameraCount do
        local b = Controls[fmt("camera_active_%03d", j)]
        local want = (j == i)
        if b ~= nil and b.Boolean ~= want then b.Boolean = want end
      end
      Suppress = Suppress - 1
    end
  
    local function SetActiveIndex(i)
      ActiveIndex = i
      WriteActiveButtons(i)
      UpdateActiveName()
      BindActiveFeedback()
      if RouteActiveToRouter then RouteActiveToRouter() end
      dbg("active camera slot", i)
    end
  
    -- ===== Router tracking =====
    -- The active camera follows the source routed to a chosen router output.
    local function RouterOutputNum()
      local n = (Controls["router_output"] and Controls["router_output"].Value) or 1
      n = math.floor(n)
      if n < 1 then n = 1 end
      return n
    end
  
    -- Router components disagree on control naming: the classic Router and
    -- Router with Mixer expose "select.N", while the MediaCast Router renamed
    -- the same control to "output.N.select". Resolve the name against the bound
    -- component instead of assuming either form.
    local SELECT_FORMS = {"select.%d", "output.%d.select"}
  
    -- Snapshot the bound router's control names so a renamed readout can be
    -- matched by pattern rather than guessed.
    local function IndexRouterControls()
      RouterCtlNames = {}
      if RouterProxy == nil then return end
      local ok, ctrls = pcall(function() return Component.GetControls(RouterProxy) end)
      if not ok or ctrls == nil then return end
      for _, ctl in ipairs(ctrls) do
        if type(ctl.Name) == "string" then table.insert(RouterCtlNames, ctl.Name) end
      end
      table.sort(RouterCtlNames)
      dbg("router controls:", table.concat(RouterCtlNames, " "))
    end
  
    local function ResolveSelectCtl(out)
      for _, form in ipairs(SELECT_FORMS) do
        local name = fmt(form, out)
        if HasControl(RouterProxy, name) then return name end
      end
      return nil
    end
  
    -- Routed-source-name readout: the classic name first, then any control on
    -- this router whose name carries "source", "name" and the output index.
    local function ResolveSourceNameCtl(out)
      local classic = fmt("output.%d.source.name", out)
      if HasControl(RouterProxy, classic) then return classic end
      local tok = "." .. out .. "."
      for _, name in ipairs(RouterCtlNames) do
        local lower = string.lower(name)
        if string.find(lower, "source", 1, true)
           and string.find(lower, "name", 1, true)
           and string.find("." .. lower .. ".", tok, 1, true) then
          return name
        end
      end
      return nil
    end
  
    local function ResolveRouterCtls()
      RouterSelCtl = nil
      RouterSrcCtl = nil
      if RouterProxy == nil then return end
      local out = RouterOutputNum()
      RouterSelCtl = ResolveSelectCtl(out)
      RouterSrcCtl = ResolveSourceNameCtl(out)
      if RouterSelCtl == nil then
        dbg("router exposes no output-select control for output", out)
      else
        dbg("router output", out, "select control", RouterSelCtl)
      end
    end
  
    -- Router output select (Integer input index) drives the active slot.
    local function ApplyRouterTracking()
      if RouterProxy == nil then return end
      local k, src
      if RouterSelCtl ~= nil then pcall(function() k   = RouterProxy[RouterSelCtl].Value end) end
      if RouterSrcCtl ~= nil then pcall(function() src = RouterProxy[RouterSrcCtl].String end) end
      local srcCtl = Controls["tracked_source"]
      if srcCtl and srcCtl.String ~= (src or "") then srcCtl.String = src or "" end
      if k ~= nil then
        k = math.floor(k)
        if k >= 1 and k <= CameraCount and k ~= ActiveIndex then
          RouterApplying = true   -- this change came from the router; don't route back
          SetActiveIndex(k)
          RouterApplying = false
        end
      end
    end
  
    -- Route the active camera to the output: slot index == router input index.
    RouteActiveToRouter = function()
      if RouterApplying or RouterProxy == nil then return end
      if RouterSelCtl == nil then ResolveRouterCtls() end
      local selCtl = RouterSelCtl
      if selCtl ~= nil then
        pcall(function()
          if math.floor((RouterProxy[selCtl].Value or -1)) ~= ActiveIndex then
            RouterProxy[selCtl].Value = ActiveIndex
          end
        end)
        dbg("routed output", RouterOutputNum(), "-> input", ActiveIndex)
      end
    end
  
    local function UnbindRouter()
      if RouterProxy ~= nil and RouterBoundCtl ~= nil and HasControl(RouterProxy, RouterBoundCtl) then
        pcall(function() RouterProxy[RouterBoundCtl].EventHandler = nil end)
      end
      RouterBoundCtl = nil
    end
  
    local function BindRouter()
      UnbindRouter()
      if RouterProxy == nil then
        RouterSelCtl = nil
        RouterSrcCtl = nil
        return
      end
      ResolveRouterCtls()
      local selCtl = RouterSelCtl
      if selCtl ~= nil then
        pcall(function()
          RouterProxy[selCtl].EventHandler = function() ApplyRouterTracking() end
        end)
        RouterBoundCtl = selCtl
      end
      ApplyRouterTracking()
    end
  
    local function RebuildRouterProxy()
      UnbindRouter()
      RouterProxy = nil
      local sel = Controls["router_select"]
      local name = sel and sel.String or ""
      if name ~= "" then
        local ok, comp = pcall(Component.New, name)
        if ok and comp ~= nil then RouterProxy = comp end
      end
      IndexRouterControls()
      local foundCtl = Controls["router_found"]
      if foundCtl and foundCtl.Boolean ~= (RouterProxy ~= nil) then foundCtl.Boolean = (RouterProxy ~= nil) end
      local srcCtl = Controls["tracked_source"]
      if RouterProxy == nil and srcCtl and srcCtl.String ~= "" then srcCtl.String = "" end
      BindRouter()
    end
  
    -- Find router / mediacast-router components in the design.
    local function DiscoverRouters()
      local list = {}
      local ok, comps = pcall(Component.GetComponents)
      if not ok or comps == nil then return list end
      for _, c in ipairs(comps) do
        local isR = false
        if type(c.Type) == "string" and string.find(string.lower(c.Type), "router", 1, true) then
          isR = true
        end
        if not isR then
          local ok2, ctrls = pcall(function() return Component.GetControls(Component.New(c.Name)) end)
          if ok2 and ctrls ~= nil then
            for _, ctl in ipairs(ctrls) do
              -- "select.1" = classic Router; "output.1.select" = MediaCast Router
              if ctl.Name == "select.1" or ctl.Name == "output.1.select" then isR = true break end
            end
          end
        end
        if isR then table.insert(list, c.Name) end
      end
      table.sort(list)
      return list
    end
  
    local function RefreshRouterList()
      local sel = Controls["router_select"]
      if sel == nil then return end
      local list = DiscoverRouters()
      local cur = sel.String
      if cur ~= nil and cur ~= "" then
        local present = false
        for _, n in ipairs(list) do if n == cur then present = true break end end
        if not present then table.insert(list, cur) end
      end
      table.insert(list, 1, "")  -- blank option = no tracking
      sel.Choices = list
      RebuildRouterProxy()
    end
  
    -- ===== Event handlers =====
    if Controls["router_select"] ~= nil then
      Controls["router_select"].EventHandler = function() RebuildRouterProxy() end
    end
    if Controls["router_output"] ~= nil then
      Controls["router_output"].EventHandler = function() BindRouter() end
    end
  
    for i = 1, CameraCount do
      local sel = Controls[fmt("camera_select_%03d", i)]
      local act = Controls[fmt("camera_active_%03d", i)]
      if sel ~= nil then
        sel.EventHandler = function()
          RebuildProxy(i)
          if i == ActiveIndex then UpdateActiveName(); BindActiveFeedback(); if RouteActiveToRouter then RouteActiveToRouter() end end
        end
      end
      if act ~= nil then
        act.EventHandler = function(ctl)
          if Suppress > 0 then return end
          if ctl.Boolean then
            SetActiveIndex(i)
          else
            -- A slot went low. Never force THIS slot back high: that fights the
            -- radio write and latches two slots on. Re-assert the real active
            -- slot instead -- idempotent, so a correct radio settles silently
            -- and pressing the active slot simply re-lights it.
            WriteActiveButtons(ActiveIndex)
          end
        end
      end
    end
  
    for name, target in pairs(PTZ_MAP) do
      local ctl = Controls[name]
      if ctl ~= nil then
        ctl.EventHandler = function(c) SetCtl(target, c.Boolean) end
      end
    end
  
    for name, def in pairs(DIAG_MAP) do
      local ctl = Controls[name]
      if ctl ~= nil then
        ctl.EventHandler = function(c) DriveDiagonal(def, c.Boolean) end
      end
    end
  
    for name, target in pairs(TRIGGER_MAP) do
      local ctl = Controls[name]
      if ctl ~= nil then
        ctl.EventHandler = function() PulseCtl(target) end
      end
    end
  
    if Controls["privacy_load"] ~= nil then
      Controls["privacy_load"].EventHandler = function(ctl)
        if PrivacyFbSuppress then return end
        SetCtl(PRIVACY_TOGGLE, ctl.Boolean)
      end
    end
  
    -- Operator edits go back to the active camera. Read-only entries have no
    -- handler at all, so nothing can be typed into a value the camera owns.
    local function WriteOut(d, c)
      if CamFbSuppress[d.name] then return end
      if d.kind == "trigger" then PulseCtl(d.name) return end
      local cam = ActiveCam()
      if cam == nil or not HasControl(cam, d.name) then return end
      if d.kind == "statetrig" then
        -- Momentary, so only the press is a request -- the low edge is our own
        -- feedback write settling and must not fire the camera again.
        if not c.Boolean then return end
        local trig = d.name .. ".trigger"
        if HasControl(cam, trig) then PulseCtl(trig) else PulseCtl(d.name) end
        return
      end
      if d.kind == "int" or d.kind == "float" then
        pcall(function() if cam[d.name].Value ~= c.Value then cam[d.name].Value = c.Value end end)
      elseif d.kind == "bool" then
        pcall(function() if cam[d.name].Boolean ~= c.Boolean then cam[d.name].Boolean = c.Boolean end end)
      elseif d.kind == "enum" or d.kind == "text" then
        pcall(function() if cam[d.name].String ~= c.String then cam[d.name].String = c.String end end)
      end
    end
  
    local READ_ONLY_KIND = {ro = true, led = true, status = true, media = true}
    for _, d in ipairs(CamCtls) do
      local ctl = Controls[d.name]
      if ctl ~= nil and not READ_ONLY_KIND[d.kind] then
        ctl.EventHandler = function(c) WriteOut(d, c) end
      end
    end
  
    for _, t in ipairs(CamPageTriggers) do
      local ctl = Controls[t.name]
      if ctl ~= nil then
        ctl.EventHandler = function() PulseCtl(t.name) end
      end
    end
  
    if Controls["ptz_af"] ~= nil then
      Controls["ptz_af"].EventHandler = function() PulseCtl("focus.auto") end
    end
  
    -- Editing the Coordinates field writes the position to the active camera.
    if Controls["coordinates"] ~= nil then
      Controls["coordinates"].EventHandler = function(ctl)
        if CoordFbSuppress then return end
        local cam = ActiveCam()
        if cam ~= nil and HasControl(cam, COORD_CTRL) then
          pcall(function()
            if cam[COORD_CTRL].String ~= ctl.String then cam[COORD_CTRL].String = ctl.String end
          end)
        end
      end
    end
  
    -- Tap = recall; hold = save the moment the hold time elapses (while held).
    local Saved = {}
    local Countdown = {}
    for p = 1, NumPresets do
      local btn = Controls[fmt("preset_%03d", p)]
      if btn ~= nil then
        Saved[p] = false
        Countdown[p] = Timer.New()
        Countdown[p].EventHandler = function()
          Countdown[p]:Stop()
          PresetHoldSave(p)   -- fires as soon as the hold completes
          Saved[p] = true
        end
        btn.EventHandler = function(ctl)
          if PresetFbSuppress then return end   -- ignore highlight-driven writes
          if ctl.Boolean then
            Saved[p] = false
            Countdown[p]:Start(HoldTime)
          else
            Countdown[p]:Stop()
            if not Saved[p] then PresetRecallTap(p) end
            Saved[p] = false
            UpdatePresetHighlights()
          end
        end
      end
    end
  
    -- ===== Initialise =====
    DisabledTimer:Start(3)
    LoadStore()
    RefreshCameraLists()
  
    local initActive = 1
    for j = 1, CameraCount do
      local b = Controls[fmt("camera_active_%03d", j)]
      if b ~= nil and b.Boolean then initActive = j break end
    end
    SetActiveIndex(initActive)
  
    RefreshRouterList()  -- may override the active camera if a router is tracking
end
