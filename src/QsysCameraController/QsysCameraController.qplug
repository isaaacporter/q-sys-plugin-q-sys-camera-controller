-- Information block for the plugin
PluginInfo = {
  Name = "Cameras~Q-SYS Camera Controller",
  Description = "Select and PTZ-control any PTZ-capable camera component in the design from one shared control set.",
  Version = "1.1.0.0",
  BuildVersion = "1.1.0.0",
  Id = "4178aa21-737e-40f8-a8d0-84d09d004d1d",
  Author = "CTI, Isaac Porter",
}

--[[
###############################################################################
#
# Q-SYS Camera Controller
# Copyright 2026 Communication Technologies, Inc. (CTI)
#
# Selects among PTZ-capable camera components in the design and relays a single
# shared PTZ / preset control set to the currently selected camera.
#
# Based on the QSC, LLC. plugin framework.
#
###############################################################################
]]

-- Resources (palette, page list)
-- CTI brand colour palette (see cti_brand_preferences.md)
Palette = {
  cti_navy  = {13, 59, 102},   -- CTI Dark Blue  #0D3B66
  cti_teal  = {0, 169, 165},   -- CTI Teal       #00A9A5
  cti_amber = {255, 186, 73},  -- CTI Amber      #FFBA49
  White     = {255, 255, 255},
  Black     = {0, 0, 0},
  Gray      = {128, 128, 128},
  Red       = {200, 40, 40},
  Green     = {40, 180, 80},
  ptz_off   = {124, 124, 124},  -- #7C7C7C
  green_on  = {0, 159, 60},     -- #009F3C
  green_off = {0, 75, 22},      -- #004B16
  gray_off  = {137, 137, 137},  -- #898989
  meter_on  = {31, 78, 140},    -- #1F4E8C  filled portion of a value meter
  meter_off = {26, 32, 48}      -- #1A2030  unfilled portion
}

-- Pages shown by the plugin
PageNames = { "Setup", "Pan / Tilt / Zoom", "Imaging" }

-- Define the colour of the plugin object in the design
function GetColor(props)
  return Palette.cti_navy
end

-- The name that initially displays when dragged into a design
function GetPrettyName(props)
  return "Q-SYS Camera Controller v" .. PluginInfo.Version
end

-- Optional function used if the plugin has multiple pages
function GetPages(props)
  local pages = {}
  for ix in ipairs(PageNames) do
    table.insert(pages, {name = PageNames[ix]})
  end
  return pages
end

-- Optional function to define model if the plugin supports more than one model
function GetModel(props)
  local model = {}
  -- Single model; nothing to define.
  return model
end

-- Define user-configurable Properties of the plugin
function GetProperties()
  local props = {}
  table.insert(props, {
    Name = "Camera Count",
    Type = "integer",
    Value = 2,
    Min = 1,
    Max = 16
  })
  table.insert(props, {
    Name = "Num Presets",
    Type = "integer",
    Value = 6,
    Min = 0,
    Max = 64
  })
  table.insert(props, {
    Name = "Hold to Save (s)",
    Type = "double",
    Value = 3.0,
    Min = 0.2,
    Max = 10.0
  })
  table.insert(props, {
    Name = "Debug Print",
    Type = "enum",
    Choices = {"None", "Function Calls", "Tx", "All"},
    Value = "None"
  })
  return props
end

-- Optional function to define pins not connected to a Control
function GetPins(props)
  local pins = {}
  -- All pins are derived from Controls (UserPin); no extra pins required.
  return pins
end

-- Optional function to update available properties when properties are altered
function RectifyProperties(props)
  -- No conditional property visibility required.
  return props
end

-- Optional function to define components used within the plugin
function GetComponents(props)
  local components = {}
  -- This plugin proxies to camera components elsewhere in the design at runtime
  -- via the Component library; it hosts no internal components.
  return components
end

-- Optional function to define wiring of components used within the plugin
function GetWiring(props)
  local wiring = {}
  -- No internal components, so no wiring.
  return wiring
end

-- Defines the Controls used within the plugin
function GetControls(props)
  local ctrls = {}
    local fmt = string.format
    local CameraCount = props["Camera Count"].Value
    local NumPresets  = props["Num Presets"].Value
  
    -- Camera selection -----------------------------------------------------------
    table.insert(ctrls, {
      Name = "active_camera_name",
      ControlType = "Indicator",
      IndicatorType = "Text",
      PinStyle = "Output",
      Count = 1,
      UserPin = true
    })
    -- Hidden, persistent storage for numbered preset coordinates (JSON).
    table.insert(ctrls, {
      Name = "preset_store",
      ControlType = "Text",
      Count = 1,
      UserPin = false
    })
    -- Status indicators
    table.insert(ctrls, {
      Name = "is_moving",
      ControlType = "Indicator",
      IndicatorType = "Led",
      DefaultValue = false,
      Count = 1,
      UserPin = true,
      PinStyle = "Output"
    })
    table.insert(ctrls, {
      Name = "preset_saved",
      ControlType = "Indicator",
      IndicatorType = "Led",
      DefaultValue = false,
      Count = 1,
      UserPin = true,
      PinStyle = "Output"
    })
    table.insert(ctrls, {
      Name = "coordinates",
      ControlType = "Text",
      Count = 1,
      UserPin = true,
      PinStyle = "Both"
    })
  
    -- Camera tracking via a router / mediacast router
    table.insert(ctrls, {
      Name = "router_select",
      ControlType = "Text",
      Count = 1,
      UserPin = true,
      PinStyle = "Both"
    })
    table.insert(ctrls, {
      Name = "router_output",
      ControlType = "Knob",
      ControlUnit = "Integer",
      Min = 1,
      Max = 64,
      DefaultValue = 1,
      Count = 1,
      UserPin = true,
      PinStyle = "Both"
    })
    table.insert(ctrls, {
      Name = "router_found",
      ControlType = "Indicator",
      IndicatorType = "Led",
      DefaultValue = false,
      Count = 1,
      UserPin = true,
      PinStyle = "Output"
    })
    table.insert(ctrls, {
      Name = "tracked_source",
      ControlType = "Indicator",
      IndicatorType = "Text",
      Count = 1,
      UserPin = true,
      PinStyle = "Output"
    })
  
    for i = 1, CameraCount do
      table.insert(ctrls, {
        Name = fmt("camera_active_%03d", i),
        ControlType = "Button",
        ButtonType = "Toggle",
        Count = 1,
        UserPin = true,
        PinStyle = "Both"
      })
      table.insert(ctrls, {
        Name = fmt("camera_select_%03d", i),
        ControlType = "Text",
        Count = 1,
        UserPin = true,
        PinStyle = "Both"
      })
      table.insert(ctrls, {
        Name = fmt("camera_found_%03d", i),
        ControlType = "Indicator",
        IndicatorType = "Led",
        DefaultValue = false,
        Count = 1,
        UserPin = true,
        PinStyle = "Output"
      })
    end
  
    -- Shared Pan / Tilt / Zoom / Focus -------------------------------------------
    -- Built-in icons must be declared on the control (not the layout).
    local ptzButtons = {
      {name = "ptz_up_left",    icon = "Arrow Left-Up"},
      {name = "ptz_tilt_up",    icon = "Arrow Up"},
      {name = "ptz_up_right",   icon = "Arrow Right-Up"},
      {name = "ptz_pan_left",   icon = "Arrow Left"},
      {name = "ptz_pan_right",  icon = "Arrow Right"},
      {name = "ptz_down_left",  icon = "Arrow Left-Down"},
      {name = "ptz_tilt_down",  icon = "Arrow Down"},
      {name = "ptz_down_right", icon = "Arrow Right-Down"},
      {name = "ptz_zoom_in",    icon = "Zoom In"},
      {name = "ptz_zoom_out",   icon = "Zoom Out"},
      {name = "ptz_focus_in",  icon = "Plus"},
      {name = "ptz_focus_out", icon = "Minus"}
    }
    for _, b in ipairs(ptzButtons) do
      local def = {
        Name = b.name,
        ControlType = "Button",
        ButtonType = "Momentary",
        Count = 1,
        UserPin = true,
        PinStyle = "Input"
      }
      if b.icon then def.Icon = b.icon end
      table.insert(ctrls, def)
    end
  
    -- Home / Privacy -------------------------------------------------------------
    local triggerButtons = {
      {name = "ptz_home", icon = "Home"},
      {name = "ptz_af"},
      {name = "home_save"},
      {name = "privacy_save"}
    }
    for _, b in ipairs(triggerButtons) do
      local def = {
        Name = b.name,
        ControlType = "Button",
        ButtonType = "Trigger",
        Count = 1,
        UserPin = true,
        PinStyle = "Input"
      }
      if b.icon then def.Icon = b.icon end
      table.insert(ctrls, def)
    end
  
    -- Privacy is a toggle reflecting the camera's privacy mode.
    table.insert(ctrls, {
      Name = "privacy_load",
      ControlType = "Button",
      ButtonType = "Toggle",
      Icon = "Prohibited",
      Count = 1,
      UserPin = true,
      PinStyle = "Both"
    })
  
    -- Imaging / Exposure ---------------------------------------------------------
    -- Integer value fields mirrored from the active camera.
    local numFields = {
      {name = "img.brightness", min = 0,  max = 14},
      {name = "exp.comp",       min = -7, max = 7}
    }
    for _, n in ipairs(numFields) do
      table.insert(ctrls, {
        Name = n.name,
        ControlType = "Knob",
        ControlUnit = "Integer",
        Min = n.min,
        Max = n.max,
        DefaultValue = 0,
        Count = 1,
        UserPin = true,
        PinStyle = "Both"
      })
    end
  
    -- Imaging / White Balance ----------------------------------------------------
    -- Named to match the native QSC camera controls they drive.
    -- Choices are mirrored from the active camera at runtime.
    table.insert(ctrls, {
      Name = "wb.awb.mode",
      ControlType = "Text",
      Count = 1,
      UserPin = true,
      PinStyle = "Both"
    })
    table.insert(ctrls, {
      Name = "wb.one.push.trigger",
      ControlType = "Button",
      ButtonType = "Trigger",
      Count = 1,
      UserPin = true,
      PinStyle = "Input"
    })
  
    -- Numbered presets (tap = recall, hold = save). The button itself lights
    -- (its .Boolean is driven) when the camera is at that stored position.
    for p = 1, NumPresets do
      table.insert(ctrls, {
        Name = fmt("preset_%03d", p),
        ControlType = "Button",
        ButtonType = "Momentary",
        Count = 1,
        UserPin = true,
        PinStyle = "Both"
      })
    end
  return ctrls
end

-- Layout of controls and graphics for the plugin UI
function GetControlLayout(props)
  local layout = {}
  local graphics = {}
    local fmt = string.format
    local pidx = (props["page_index"] and props["page_index"].Value) or 1
    local CurrentPage = PageNames[pidx]
  
    local CameraCount = props["Camera Count"].Value
    local NumPresets  = props["Num Presets"].Value
  
    local fs1  = 12
    local h1   = 20
    local hB   = 32
    local rowH = 30
  
    -- The native camera block is 435px wide and every group box fills it.
    local PLUGIN_W  = 435
    local rightEdge = PLUGIN_W
  
    -- Camera group geometry (Setup page)
    local camGX, camGY = 0, 44
    local camGW = PLUGIN_W
    local rowY0 = camGY + 28
    local footerY = rowY0 + CameraCount * rowH + 8
    local camGH = (footerY + 26) - camGY + 8
  
    -- Pan / Tilt / Zoom group geometry (styled like the native QSC camera block)
    local ptzGX, ptzGY = 0, 44
    local ptzGW  = PLUGIN_W
    local padX, padY = ptzGX + 100, ptzGY + 30
    local zoomX  = padX + 3 * hB + 10
    local focusX = zoomX + hB + 8
    local hpX    = focusX + hB + 4
    local hpLblW, hpIcon, hpSaveW = 46, 28, 46
    local ptzGH  = 30 + 3 * hB + 14 + 30   -- extra row for the Coordinates readout
  
    if CurrentPage == "Setup" then
  
      -- Title / build info -----------------------------------------------------
      table.insert(graphics, {
        Type = "Text", Text = "Q-SYS Camera Controller", FontSize = 16,
        FontStyle = "Bold", HTextAlign = "Left", Color = Palette.cti_navy,
        Position = {0, 4}, Size = {360, 24}
      })
      table.insert(graphics, {
        Type = "Text", Text = "v" .. PluginInfo.BuildVersion, FontSize = fs1,
        HTextAlign = "Right", Color = Palette.Gray,
        Position = {rightEdge - 120, 8}, Size = {120, h1}
      })
  
      -- Camera selection group -------------------------------------------------
      table.insert(graphics, {
        Type = "GroupBox", Text = "Cameras", FontSize = fs1, HTextAlign = "Left",
        Fill = Palette.White, StrokeColor = Palette.cti_navy, StrokeWidth = 1,
        CornerRadius = 8, Position = {camGX, camGY}, Size = {camGW, camGH}
      })
  
      for r = 0, CameraCount - 1 do
        local i = r + 1
        local y = rowY0 + r * rowH
        layout[fmt("camera_active_%03d", i)] = {
          PrettyName = fmt("Cameras~%d Select", i),
          Legend = tostring(i), Style = "Button",
          Color = {0, 210, 70}, OffColor = Palette.cti_navy, UnlinkOffColor = true,
          Margin = 3, Position = {camGX + 8, y}, Size = {26, 26}
        }
        layout[fmt("camera_select_%03d", i)] = {
          PrettyName = fmt("Cameras~%d Component", i),
          Style = "ComboBox", FontSize = fs1, Color = Palette.White,
          Padding = 2, StrokeWidth = 1,
          Position = {camGX + 40, y + 1}, Size = {camGW - 76, 24}
        }
        layout[fmt("camera_found_%03d", i)] = {
          PrettyName = fmt("Cameras~%d Found", i),
          Style = "Indicator", Color = Palette.Green, OffColor = {16, 40, 24},
          UnlinkOffColor = true, StrokeWidth = 1, Margin = 2,
          Position = {camGX + camGW - 28, y + 4}, Size = {18, 18}
        }
      end
  
      table.insert(graphics, {Type = "Text", Text = "Active", FontSize = fs1, HTextAlign = "Left", Color = Palette.cti_navy, Position = {camGX + 12, footerY + 3}, Size = {48, h1}})
      layout["active_camera_name"] = {
        PrettyName = "Cameras~Active Camera", Style = "Text", FontSize = fs1,
        HTextAlign = "Center", Color = Palette.White, Padding = 2, StrokeWidth = 1,
        Position = {camGX + 60, footerY}, Size = {camGW - 72, 26}
      }
  
      -- Camera Router group ----------------------------------------------------
      local trackTop = camGY + camGH + 14
      local tY  = trackTop + 26
      local tY2 = tY + 30
  
      table.insert(graphics, {
        Type = "GroupBox", Text = "Camera Router (Optional)", FontSize = fs1, HTextAlign = "Left",
        Fill = Palette.White, StrokeColor = Palette.cti_navy, StrokeWidth = 1,
        CornerRadius = 8, Position = {0, trackTop}, Size = {PLUGIN_W, 92}
      })
      table.insert(graphics, {Type = "Text", Text = "Router", FontSize = fs1, HTextAlign = "Left", Color = Palette.cti_navy, Position = {12, tY + 3}, Size = {48, h1}})
      layout["router_select"] = {PrettyName = "Router~Component", Style = "ComboBox", FontSize = fs1, Color = Palette.White, Padding = 2, StrokeWidth = 1, Position = {62, tY}, Size = {PLUGIN_W - 62 - 40, 24}}
      layout["router_found"] = {PrettyName = "Router~Found", Style = "Indicator", Color = Palette.Green, OffColor = {16, 40, 24}, UnlinkOffColor = true, StrokeWidth = 1, Margin = 2, Position = {PLUGIN_W - 28, tY + 3}, Size = {18, 18}}
  
      table.insert(graphics, {Type = "Text", Text = "Output", FontSize = fs1, HTextAlign = "Left", Color = Palette.cti_navy, Position = {12, tY2 + 3}, Size = {50, h1}})
      layout["router_output"] = {PrettyName = "Router~Output", Style = "Text", Color = Palette.White, OffColor = Palette.White, UnlinkOffColor = true, FontSize = fs1, HTextAlign = "Center", Padding = 2, StrokeWidth = 1, Position = {66, tY2}, Size = {56, 24}}
      table.insert(graphics, {Type = "Text", Text = "Source", FontSize = fs1, HTextAlign = "Left", Color = Palette.cti_navy, Position = {132, tY2 + 3}, Size = {50, h1}})
      layout["tracked_source"] = {PrettyName = "Router~Source", Style = "Text", FontSize = fs1, HTextAlign = "Center", Color = Palette.White, Padding = 2, StrokeWidth = 1, Position = {186, tY2}, Size = {PLUGIN_W - 186 - 12, 24}}
  
    elseif CurrentPage == "Pan / Tilt / Zoom" then
  
      -- Title / build info -----------------------------------------------------
      table.insert(graphics, {
        Type = "Text", Text = "Q-SYS Camera Controller", FontSize = 16,
        FontStyle = "Bold", HTextAlign = "Left", Color = Palette.cti_navy,
        Position = {0, 4}, Size = {360, 24}
      })
      table.insert(graphics, {
        Type = "Text", Text = "v" .. PluginInfo.BuildVersion, FontSize = fs1,
        HTextAlign = "Right", Color = Palette.Gray,
        Position = {rightEdge - 120, 8}, Size = {120, h1}
      })
  
      -- Pan / Tilt / Zoom group ------------------------------------------------
      table.insert(graphics, {
        Type = "GroupBox", Text = "Pan / Tilt / Zoom", FontSize = fs1,
        HTextAlign = "Left", Fill = Palette.White, StrokeColor = Palette.cti_navy,
        StrokeWidth = 1, CornerRadius = 8,
        Position = {ptzGX, ptzGY}, Size = {ptzGW, ptzGH}
      })
      table.insert(graphics, {
        Type = "Text", Text = "Pan, Tilt, and\nZoom Controls", FontSize = fs1,
        HTextAlign = "Center", Color = Palette.cti_navy,
        Position = {ptzGX + 8, padY + 16}, Size = {90, 48}
      })
  
      -- 3x3 directional pad with an empty centre (matches the QSC layout)
      local pad = {
        ptz_up_left    = {padX,          padY},
        ptz_tilt_up    = {padX + hB,     padY},
        ptz_up_right   = {padX + 2 * hB, padY},
        ptz_pan_left   = {padX,          padY + hB},
        ptz_pan_right  = {padX + 2 * hB, padY + hB},
        ptz_down_left  = {padX,          padY + 2 * hB},
        ptz_tilt_down  = {padX + hB,     padY + 2 * hB},
        ptz_down_right = {padX + 2 * hB, padY + 2 * hB}
      }
      local ptzPretty = {
        ptz_up_left    = "Pan-Tilt-Zoom~Pan Left / Tilt Up",
        ptz_tilt_up    = "Pan-Tilt-Zoom~Tilt Up",
        ptz_up_right   = "Pan-Tilt-Zoom~Pan Right / Tilt Up",
        ptz_pan_left   = "Pan-Tilt-Zoom~Pan Left",
        ptz_pan_right  = "Pan-Tilt-Zoom~Pan Right",
        ptz_down_left  = "Pan-Tilt-Zoom~Pan Left / Tilt Down",
        ptz_tilt_down  = "Pan-Tilt-Zoom~Tilt Down",
        ptz_down_right = "Pan-Tilt-Zoom~Pan Right / Tilt Down"
      }
      for name, pos in pairs(pad) do
        layout[name] = {
          PrettyName = ptzPretty[name],
          Legend = "", Style = "Button",
          Color = Palette.White, OffColor = Palette.ptz_off, UnlinkOffColor = true,
          Margin = 3, Position = {pos[1], pos[2]}, Size = {hB, hB}
        }
      end
  
      -- Zoom (magnifier icons)
      table.insert(graphics, {Type = "Text", Text = "Zoom", FontSize = fs1, HTextAlign = "Center", Position = {zoomX - 6, padY - 18}, Size = {hB + 12, h1}})
      layout["ptz_zoom_in"]  = {PrettyName = "Pan-Tilt-Zoom~Zoom In",  Legend = "", Style = "Button", Color = Palette.White, OffColor = Palette.ptz_off, UnlinkOffColor = true, Margin = 3, Position = {zoomX, padY},      Size = {hB, hB}}
      layout["ptz_zoom_out"] = {PrettyName = "Pan-Tilt-Zoom~Zoom Out", Legend = "", Style = "Button", Color = Palette.White, OffColor = Palette.ptz_off, UnlinkOffColor = true, Margin = 3, Position = {zoomX, padY + hB}, Size = {hB, hB}}
  
      -- Focus (In / Out / AF)
      table.insert(graphics, {Type = "Text", Text = "Focus", FontSize = fs1, HTextAlign = "Center", Position = {focusX - 8, padY - 18}, Size = {hB + 16, h1}})
      layout["ptz_focus_in"]  = {PrettyName = "Focus~In",  Legend = "", Style = "Button", Color = Palette.White, OffColor = Palette.ptz_off, UnlinkOffColor = true, Margin = 3, Position = {focusX, padY},          Size = {hB, hB}}
      layout["ptz_focus_out"] = {PrettyName = "Focus~Out", Legend = "", Style = "Button", Color = Palette.White, OffColor = Palette.ptz_off, UnlinkOffColor = true, Margin = 3, Position = {focusX, padY + hB},     Size = {hB, hB}}
      layout["ptz_af"]        = {PrettyName = "Focus~AF",  Legend = "AF", Style = "Button", Color = Palette.White, OffColor = Palette.ptz_off, UnlinkOffColor = true, Margin = 3, Position = {focusX, padY + 2 * hB}, Size = {hB, hB}}
  
      -- Is Moving status LED
      table.insert(graphics, {Type = "Text", Text = "Moving", FontSize = fs1, HTextAlign = "Left", Color = Palette.cti_navy, Position = {ptzGX + 12, padY + 70}, Size = {50, h1}})
      layout["is_moving"] = {PrettyName = "Pan-Tilt-Zoom~Is Moving", Style = "Indicator", Color = Palette.cti_amber, OffColor = {60, 46, 16}, UnlinkOffColor = true, StrokeWidth = 1, Margin = 2, Position = {ptzGX + 64, padY + 70}, Size = {18, 18}}
  
      -- Home / Privacy (icon + red save, as on the native camera)
      local homeY = padY + 6
      local privY = padY + hB + 14
      table.insert(graphics, {Type = "Text", Text = "Home",    FontSize = fs1, HTextAlign = "Right", Color = Palette.cti_navy, Position = {hpX, homeY + 4}, Size = {hpLblW, h1}})
      table.insert(graphics, {Type = "Text", Text = "Privacy", FontSize = fs1, HTextAlign = "Right", Color = Palette.cti_navy, Position = {hpX, privY + 4}, Size = {hpLblW, h1}})
  
      layout["ptz_home"]     = {PrettyName = "Pan-Tilt-Zoom~Home",         Legend = "",             Style = "Button", Color = Palette.green_on, OffColor = Palette.green_off, UnlinkOffColor = true, Margin = 3, Position = {hpX + 52,        homeY}, Size = {hpIcon, 28}}
      layout["home_save"]    = {PrettyName = "Pan-Tilt-Zoom~Save Home",    Legend = "Save\nHome",    FontSize = 10, Style = "Button", Color = Palette.Red, Margin = 3, Position = {hpX + 52 + hpIcon + 6, homeY}, Size = {hpSaveW, 28}}
      layout["privacy_load"] = {PrettyName = "Pan-Tilt-Zoom~Privacy Mode", Legend = "",             Style = "Button", Color = Palette.green_on, OffColor = Palette.gray_off, UnlinkOffColor = true, Margin = 3, Position = {hpX + 52,        privY}, Size = {hpIcon, 28}}
      layout["privacy_save"] = {PrettyName = "Pan-Tilt-Zoom~Save Privacy", Legend = "Save\nPrivacy", FontSize = 10, Style = "Button", Color = Palette.Red, Margin = 3, Position = {hpX + 52 + hpIcon + 6, privY}, Size = {hpSaveW, 28}}
  
      -- Coordinates readout (current ptz.preset position)
      local coordsY = padY + 3 * hB + 8
      table.insert(graphics, {Type = "Text", Text = "Coordinates", FontSize = fs1, HTextAlign = "Left", Color = Palette.cti_navy, Position = {ptzGX + 12, coordsY + 2}, Size = {90, h1}})
      layout["coordinates"] = {PrettyName = "Pan-Tilt-Zoom~Coordinates", Style = "Text", FontSize = fs1, HTextAlign = "Center", Color = Palette.White, OffColor = Palette.White, UnlinkOffColor = true, Padding = 2, StrokeWidth = 1, Position = {padX, coordsY}, Size = {200, 22}}
  
      -- Presets group (right column, under the PTZ block; single row of presets)
      if NumPresets > 0 then
        local presetGX  = ptzGX
        local presetTop = ptzGY + ptzGH + 14
        local btnX0     = presetGX + 12
        local btnRow    = presetTop + 28
        local presetGW  = PLUGIN_W
        -- Wrap onto as many rows as the 435px width needs.
        local perRow    = math.max(1, math.floor((presetGW - 24) / hB))
        local presetRows = math.ceil(NumPresets / perRow)
        local presetGH  = (btnRow + presetRows * hB) - presetTop + 10
  
        table.insert(graphics, {
          Type = "GroupBox", Text = "Presets", FontSize = fs1, HTextAlign = "Left",
          Fill = Palette.White, StrokeColor = Palette.cti_navy, StrokeWidth = 1,
          CornerRadius = 8, Position = {presetGX, presetTop}, Size = {presetGW, presetGH}
        })
        table.insert(graphics, {Type = "Text", Text = "tap = recall   hold = save", FontSize = fs1, HTextAlign = "Center", Color = Palette.Gray, Position = {presetGX + 80, presetTop + 2}, Size = {presetGW - 240, h1}})
        table.insert(graphics, {Type = "Text", Text = "Preset Saved", FontSize = fs1, HTextAlign = "Right", Color = Palette.cti_navy, Position = {presetGX + presetGW - 150, presetTop + 2}, Size = {120, h1}})
        layout["preset_saved"] = {PrettyName = "Presets~Saved", Style = "Indicator", Color = Palette.cti_amber, OffColor = {60, 46, 16}, UnlinkOffColor = true, StrokeWidth = 1, Margin = 2, Position = {presetGX + presetGW - 26, presetTop + 4}, Size = {18, 18}}
  
        for p = 1, NumPresets do
          local col = (p - 1) % perRow
          local row = math.floor((p - 1) / perRow)
          layout[fmt("preset_%03d", p)] = {
            PrettyName = fmt("Presets~%d", p), Legend = tostring(p),
            Style = "Button", Color = Palette.green_on, OffColor = Palette.ptz_off,
            UnlinkOffColor = true, Margin = 3,
            Position = {btnX0 + col * hB, btnRow + row * hB}, Size = {hB, hB}
          }
        end
      end
  
    elseif CurrentPage == "Imaging" then
  
      -- Imaging / Exposure / White Balance groups, stacked to mirror the native
      -- QSC camera Imaging block.
      local wbGX = 0
      local grpW = PLUGIN_W
      local lblW = 110
      local valX = wbGX + 12 + lblW + 10
      local valW = grpW - lblW - 44
  
      -- A label plus an integer value field rendered as a text box with a meter
      -- fill behind it: a Knob laid out as "Text" fills up to its value in Color
      -- and leaves the remainder in OffColor.
      local function ValueRow(name, pretty, label, y)
        table.insert(graphics, {
          Type = "Text", Text = label, FontSize = fs1, HTextAlign = "Right",
          Color = Palette.cti_navy, Position = {wbGX + 12, y + 4}, Size = {lblW, h1}
        })
        layout[name] = {
          PrettyName = pretty, Style = "Text", FontSize = fs1, HTextAlign = "Center",
          Color = Palette.meter_on, OffColor = Palette.meter_off, UnlinkOffColor = true,
          TextColor = Palette.White, Padding = 2, StrokeWidth = 1,
          Position = {valX, y}, Size = {valW, 26}
        }
      end
  
      local imgGY = 44
      local imgGH = 62
      local expGY = imgGY + imgGH + 14
      local expGH = 62
      local wbGY = expGY + expGH + 14
      local wbGW, wbGH = grpW, 98
      local rowY  = wbGY + 26
      local row2Y = rowY + 32
  
      -- Title / build info -----------------------------------------------------
      table.insert(graphics, {
        Type = "Text", Text = "Q-SYS Camera Controller", FontSize = 16,
        FontStyle = "Bold", HTextAlign = "Left", Color = Palette.cti_navy,
        Position = {0, 4}, Size = {360, 24}
      })
      table.insert(graphics, {
        Type = "Text", Text = "v" .. PluginInfo.BuildVersion, FontSize = fs1,
        HTextAlign = "Right", Color = Palette.Gray,
        Position = {wbGW - 120, 8}, Size = {120, h1}
      })
  
      table.insert(graphics, {
        Type = "GroupBox", Text = "Imaging", FontSize = fs1, HTextAlign = "Left",
        Fill = Palette.White, StrokeColor = Palette.cti_navy, StrokeWidth = 1,
        CornerRadius = 8, Position = {wbGX, imgGY}, Size = {grpW, imgGH}
      })
      ValueRow("img.brightness", "Imaging~Brightness", "Brightness", imgGY + 26)
  
      table.insert(graphics, {
        Type = "GroupBox", Text = "Exposure", FontSize = fs1, HTextAlign = "Left",
        Fill = Palette.White, StrokeColor = Palette.cti_navy, StrokeWidth = 1,
        CornerRadius = 8, Position = {wbGX, expGY}, Size = {grpW, expGH}
      })
      ValueRow("exp.comp", "Exposure~Compensation", "Compensation", expGY + 26)
  
      table.insert(graphics, {
        Type = "GroupBox", Text = "White Balance", FontSize = fs1, HTextAlign = "Left",
        Fill = Palette.White, StrokeColor = Palette.cti_navy, StrokeWidth = 1,
        CornerRadius = 8, Position = {wbGX, wbGY}, Size = {wbGW, wbGH}
      })
      table.insert(graphics, {
        Type = "Text", Text = "Mode", FontSize = fs1, HTextAlign = "Right",
        Color = Palette.cti_navy, Position = {wbGX + 12, rowY + 4}, Size = {lblW, h1}
      })
      layout["wb.awb.mode"] = {
        PrettyName = "Imaging~AWB Mode", Style = "ComboBox", FontSize = fs1,
        HTextAlign = "Center", Color = Palette.White, Padding = 2, StrokeWidth = 1,
        Position = {wbGX + 12 + lblW + 10, rowY}, Size = {wbGW - lblW - 44, 26}
      }
  
      table.insert(graphics, {
        Type = "Text", Text = "AWB One Push", FontSize = fs1, HTextAlign = "Right",
        Color = Palette.cti_navy, Position = {wbGX + 12, row2Y + 4}, Size = {lblW, h1}
      })
      layout["wb.one.push.trigger"] = {
        PrettyName = "Imaging~AWB One Push", Legend = "", Style = "Button",
        Color = Palette.green_on, OffColor = Palette.gray_off, UnlinkOffColor = true,
        Margin = 3, Position = {wbGX + 12 + lblW + 10, row2Y}, Size = {56, 28}
      }
  
    end
  return layout, graphics
end

-- Start event-based logic
if Controls then
    local fmt = string.format
    local CameraCount = Properties["Camera Count"].Value
    local NumPresets  = Properties["Num Presets"].Value
    local DebugMode   = Properties["Debug Print"].Value
    local HoldTime    = Properties["Hold to Save (s)"].Value
  
    local function dbg(...)
      if DebugMode ~= "None" then print("[CamCtrl]", ...) end
    end
  
    local ok_rj, rapidjson = pcall(require, "rapidjson")
    if not ok_rj or rapidjson == nil then
      rapidjson = rawget(_G, "rapidjson")
      ok_rj = (rapidjson ~= nil)
    end
  
    -- Each logical button maps to a native QSC camera control name.
    local PTZ_MAP = {
      ptz_pan_left  = "pan.left",
      ptz_pan_right = "pan.right",
      ptz_tilt_up   = "tilt.up",
      ptz_tilt_down = "tilt.down",
      ptz_zoom_in   = "zoom.in",
      ptz_zoom_out  = "zoom.out",
      ptz_focus_in  = "focus.far",   -- Focus In  = focus.far
      ptz_focus_out = "focus.near"   -- Focus Out = focus.near
    }
  
    -- Diagonals use the dedicated diagonal control, falling back to driving the
    -- two cardinal directions together if a camera lacks it.
    local DIAG_MAP = {
      ptz_up_left    = {ctl = "pan.left.tilt.up",    fallback = {"ptz_tilt_up",   "ptz_pan_left"}},
      ptz_up_right   = {ctl = "pan.right.tilt.up",   fallback = {"ptz_tilt_up",   "ptz_pan_right"}},
      ptz_down_left  = {ctl = "pan.left.tilt.down",  fallback = {"ptz_tilt_down", "ptz_pan_left"}},
      ptz_down_right = {ctl = "pan.right.tilt.down", fallback = {"ptz_tilt_down", "ptz_pan_right"}}
    }
  
    -- One-shot trigger buttons.
    local TRIGGER_MAP = {
      ptz_home     = "preset.home.load",
      home_save    = "preset.home.save.trigger",
      privacy_save = "preset.private.save.trigger",
      ["wb.one.push.trigger"] = "wb.one.push.trigger"
    }
  
    -- Positions are read/written as a coordinate string on this control.
    local COORD_CTRL = "ptz.preset"
    -- Privacy recall toggles this Boolean.
    local PRIVACY_TOGGLE = "toggle.privacy"
    -- Auto white balance mode (a ComboBox on the native camera).
    local WB_MODE = "wb.awb.mode"
    -- Integer value fields mirrored to/from the active camera. The plugin control
    -- and the camera control share a name, so one list drives both directions.
    local NUM_MIRROR = {"img.brightness", "exp.comp"}
  
    local Proxies = {}      -- [slot] = component proxy or nil
    local ActiveIndex = 1
    local Suppress = 0      -- depth counter guarding re-entrant radio writes
  
    local UpdatePresetHighlights    -- forward declaration (defined below)
    local PresetFbSuppress = false   -- guard while writing preset feedback state
    local CoordFbSuppress = false    -- guard while writing the coordinates readout
    local PrivacyFbSuppress = false  -- guard while writing the privacy toggle state
    local WbModeFbSuppress = false   -- guard while writing the AWB mode combo
    local NumFbSuppress = {}         -- [name] = true while writing that value field
    local NumBoundCam = {}           -- [name] = camera currently subscribed
  
    local RouterProxy = nil         -- bound router component, or nil
    local RouterBoundCtl = nil      -- the router control we are subscribed to
    local RouterCtlNames = {}       -- control names present on the bound router
    local RouterSelCtl = nil        -- resolved output-select control for the tracked output
    local RouterSrcCtl = nil        -- resolved routed-source-name control for the tracked output
    local RouteActiveToRouter       -- forward declaration (defined below)
    local RouterApplying = false    -- guard: active change originated from the router
  
    local function ActiveCam()
      return Proxies[ActiveIndex]
    end
  
    local function ActiveCamName()
      local sel = Controls[fmt("camera_select_%03d", ActiveIndex)]
      return (sel and sel.String) or ""
    end
  
    local function HasControl(cam, name)
      local ok, exists = pcall(function() return cam[name] ~= nil end)
      return ok and exists
    end
  
    -- Write a boolean to a control on the active camera, if it exists.
    local function SetCtl(name, value)
      local cam = ActiveCam()
      if cam == nil then dbg("no active camera") return end
      if not HasControl(cam, name) then dbg("target lacks", name) return end
      local ok, err = pcall(function() cam[name].Boolean = value end)
      if not ok then dbg("error setting", name, err) end
    end
  
    local function PulseCtl(name)
      SetCtl(name, true)
      SetCtl(name, false)
    end
  
    local function DriveDiagonal(def, value)
      local cam = ActiveCam()
      if cam == nil then return end
      if HasControl(cam, def.ctl) then
        pcall(function() cam[def.ctl].Boolean = value end)
      else
        for _, logical in ipairs(def.fallback) do
          SetCtl(PTZ_MAP[logical], value)
        end
      end
    end
  
    -- Reflect the active camera's privacy mode on the toggle button.
    local function UpdatePrivacyNow()
      local cam = ActiveCam()
      local v = false
      if cam and HasControl(cam, PRIVACY_TOGGLE) then
        pcall(function() v = cam[PRIVACY_TOGGLE].Boolean end)
      end
      local ctl = Controls["privacy_load"]
      if ctl then
        PrivacyFbSuppress = true
        if ctl.Boolean ~= v then ctl.Boolean = v end
        PrivacyFbSuppress = false
      end
    end
  
    -- Mirror the active camera's AWB mode: its choice list and current value.
    -- Writes are conditional so a settled combo emits no events of its own.
    local function UpdateWbModeNow()
      local ctl = Controls[WB_MODE]
      if ctl == nil then return end
      local cam = ActiveCam()
      local choices, value = nil, ""
      if cam and HasControl(cam, WB_MODE) then
        pcall(function() choices = cam[WB_MODE].Choices end)
        pcall(function() value = cam[WB_MODE].String or "" end)
      end
      WbModeFbSuppress = true
      ctl.Choices = choices or {}
      if ctl.String ~= value then ctl.String = value end
      WbModeFbSuppress = false
    end
  
    -- Mirror one integer field from the active camera. Left untouched if the
    -- camera does not expose it, so a partial model does not zero the field.
    local function UpdateNumNow(name)
      local ctl = Controls[name]
      if ctl == nil then return end
      local cam = ActiveCam()
      local v = nil
      if cam and HasControl(cam, name) then
        pcall(function() v = cam[name].Value end)
      end
      if v == nil then return end
      NumFbSuppress[name] = true
      if ctl.Value ~= v then ctl.Value = v end
      NumFbSuppress[name] = false
    end
  
    local function UpdateAllNumsNow()
      for _, n in ipairs(NUM_MIRROR) do UpdateNumNow(n) end
    end
  
    -- ===== Preset store (per camera component name) =====
    -- Persisted as JSON in the hidden "preset_store" control so it survives core
    -- restarts and design saves. Shape: { [cameraName] = { ["0"]="coord", ... } }
    local PresetStore = {}
  
    local function LoadStore()
      PresetStore = {}
      local raw = Controls["preset_store"] and Controls["preset_store"].String or ""
      if raw ~= "" and ok_rj then
        local ok, decoded = pcall(rapidjson.decode, raw)
        if ok and type(decoded) == "table" then PresetStore = decoded end
      end
    end
  
    local function SaveStore()
      if not (Controls["preset_store"] and ok_rj) then return end
      local ok, encoded = pcall(rapidjson.encode, PresetStore)
      if ok then Controls["preset_store"].String = encoded end
    end
  
    -- Preset-saved indicator: flash high for 3s on every save.
    local PresetSavedTimer = Timer.New()
    PresetSavedTimer.EventHandler = function()
      PresetSavedTimer:Stop()
      local ctl = Controls["preset_saved"]
      if ctl and ctl.Boolean then ctl.Boolean = false end
    end
    local function FlashPresetSaved()
      local ctl = Controls["preset_saved"]
      if ctl and not ctl.Boolean then ctl.Boolean = true end
      PresetSavedTimer:Start(3)
    end
  
    -- Presets are keyed by the camera's *source* identity, not the component
    -- name: a USB bridge reports its connected camera in "peripheral.camera.source",
    -- so presets follow the physical camera. Native cameras key on their own name.
    local function ActiveCamKey()
      local cam = ActiveCam()
      if cam ~= nil and HasControl(cam, "peripheral.camera.source") then
        local s
        pcall(function() s = cam["peripheral.camera.source"].String end)
        if s ~= nil and s ~= "" then return s end
      end
      return ActiveCamName()
    end
  
    -- Ensure a preset bank exists for the active camera (default "0 0 0").
    local function CheckCamera()
      local key = ActiveCamKey()
      if key == "" then return end
      local bank = PresetStore[key]
      if bank == nil then
        bank = {}
        PresetStore[key] = bank
      end
      local changed = false
      for p = 1, NumPresets do
        if bank[tostring(p)] == nil then bank[tostring(p)] = "0 0 0"; changed = true end
      end
      if changed then SaveStore() end
    end
  
    -- Tap: recall the stored position.
    local function PresetRecallTap(p)
      local cam = ActiveCam()
      if cam == nil or not HasControl(cam, COORD_CTRL) then return end
      local key = ActiveCamKey()
      local coord = PresetStore[key] and PresetStore[key][tostring(p)]
      if coord ~= nil then
        pcall(function() cam[COORD_CTRL].String = coord end)
        dbg("recall preset", p, key, coord)
      end
    end
  
    -- Hold: store the current position.
    local function PresetHoldSave(p)
      local cam = ActiveCam()
      if cam == nil or not HasControl(cam, COORD_CTRL) then return end
      CheckCamera()
      local key = ActiveCamKey()
      local coord
      pcall(function() coord = cam[COORD_CTRL].String end)
      if coord ~= nil and PresetStore[key] ~= nil then
        PresetStore[key][tostring(p)] = coord
        SaveStore()
        dbg("save preset", p, key, coord)
      end
      FlashPresetSaved()
      if UpdatePresetHighlights then UpdatePresetHighlights() end
    end
  
    local function UpdateActiveName()
      local ctl = Controls["active_camera_name"]
      local want = ActiveCamName()
      if ctl and ctl.String ~= want then ctl.String = want end
    end
  
    -- Active-camera feedback: Is Moving LED, Coordinates readout, and preset
    -- recall highlighting all follow the currently selected camera.
    local MovingBoundCam = nil
    local CoordBoundCam = nil
    local SrcBoundCam = nil
    local PrivBoundCam = nil
    local WbBoundCam = nil
  
    local function UpdateMovingNow()
      local cam = ActiveCam()
      local v = false
      if cam and HasControl(cam, "is.moving") then
        pcall(function() v = cam["is.moving"].Boolean end)
      end
      local ctl = Controls["is_moving"]
      if ctl and ctl.Boolean ~= v then ctl.Boolean = v end
    end
  
    local function CurrentCoords()
      local cam = ActiveCam()
      if cam and HasControl(cam, COORD_CTRL) then
        local s
        local ok = pcall(function() s = cam[COORD_CTRL].String end)
        if ok then return s end
      end
      return nil
    end
  
    local function UpdateCoordinatesNow()
      if Controls["coordinates"] then
        local want = CurrentCoords() or ""
        CoordFbSuppress = true
        if Controls["coordinates"].String ~= want then Controls["coordinates"].String = want end
        CoordFbSuppress = false
      end
    end
  
    -- Light the LED of each preset whose stored coordinate equals the live position.
    UpdatePresetHighlights = function()
      local cur = CurrentCoords()
      local store = PresetStore[ActiveCamKey()] or {}
      PresetFbSuppress = true
      for p = 1, NumPresets do
        local btn = Controls[fmt("preset_%03d", p)]
        if btn ~= nil then
          local saved = store[tostring(p)]
          local want = (cur ~= nil and cur ~= "" and saved ~= nil and saved ~= "" and saved ~= "0 0 0" and saved == cur)
          -- conditional for the same reason as the slot radio: a redundant write
          -- can echo back as an event and restart this update
          if btn.Boolean ~= want then btn.Boolean = want end
        end
      end
      PresetFbSuppress = false
    end
  
    local function BindActiveFeedback()
      if MovingBoundCam ~= nil and HasControl(MovingBoundCam, "is.moving") then
        pcall(function() MovingBoundCam["is.moving"].EventHandler = nil end)
      end
      MovingBoundCam = nil
      if CoordBoundCam ~= nil and HasControl(CoordBoundCam, COORD_CTRL) then
        pcall(function() CoordBoundCam[COORD_CTRL].EventHandler = nil end)
      end
      CoordBoundCam = nil
      if SrcBoundCam ~= nil and HasControl(SrcBoundCam, "peripheral.camera.source") then
        pcall(function() SrcBoundCam["peripheral.camera.source"].EventHandler = nil end)
      end
      SrcBoundCam = nil
      if PrivBoundCam ~= nil and HasControl(PrivBoundCam, PRIVACY_TOGGLE) then
        pcall(function() PrivBoundCam[PRIVACY_TOGGLE].EventHandler = nil end)
      end
      PrivBoundCam = nil
      if WbBoundCam ~= nil and HasControl(WbBoundCam, WB_MODE) then
        pcall(function() WbBoundCam[WB_MODE].EventHandler = nil end)
      end
      WbBoundCam = nil
      for _, n in ipairs(NUM_MIRROR) do
        local prev = NumBoundCam[n]
        if prev ~= nil and HasControl(prev, n) then
          pcall(function() prev[n].EventHandler = nil end)
        end
        NumBoundCam[n] = nil
      end
      local cam = ActiveCam()
      if cam ~= nil then
        if HasControl(cam, "peripheral.camera.source") then
          pcall(function()
            cam["peripheral.camera.source"].EventHandler = function()
              CheckCamera()
              UpdatePresetHighlights()
            end
          end)
          SrcBoundCam = cam
        end
        if HasControl(cam, PRIVACY_TOGGLE) then
          pcall(function()
            cam[PRIVACY_TOGGLE].EventHandler = function() UpdatePrivacyNow() end
          end)
          PrivBoundCam = cam
        end
        for _, n in ipairs(NUM_MIRROR) do
          if HasControl(cam, n) then
            pcall(function()
              cam[n].EventHandler = function() UpdateNumNow(n) end
            end)
            NumBoundCam[n] = cam
          end
        end
        if HasControl(cam, WB_MODE) then
          pcall(function()
            cam[WB_MODE].EventHandler = function() UpdateWbModeNow() end
          end)
          WbBoundCam = cam
        end
        if HasControl(cam, "is.moving") then
          pcall(function()
            cam["is.moving"].EventHandler = function(ctl)
              local out = Controls["is_moving"]
              if out and out.Boolean ~= ctl.Boolean then out.Boolean = ctl.Boolean end
            end
          end)
          MovingBoundCam = cam
        end
        if HasControl(cam, COORD_CTRL) then
          pcall(function()
            cam[COORD_CTRL].EventHandler = function()
              UpdateCoordinatesNow()
              UpdatePresetHighlights()
            end
          end)
          CoordBoundCam = cam
        end
      end
      UpdateMovingNow()
      UpdateCoordinatesNow()
      UpdatePrivacyNow()
      UpdateWbModeNow()
      UpdateAllNumsNow()
      CheckCamera()
      UpdatePresetHighlights()
    end
  
    local function RebuildProxy(i)
      local sel = Controls[fmt("camera_select_%03d", i)]
      local found = Controls[fmt("camera_found_%03d", i)]
      local name = sel and sel.String or ""
      if name ~= "" then
        local ok, comp = pcall(Component.New, name)
        if ok and comp ~= nil then
          Proxies[i] = comp
          if found and not found.Boolean then found.Boolean = true end
          dbg("bound slot", i, "->", name)
          return
        end
      end
      Proxies[i] = nil
      if found and found.Boolean then found.Boolean = false end
    end
  
    local function DiscoverCameras()
      local list = {}
      local ok, comps = pcall(Component.GetComponents)
      if not ok or comps == nil then
        dbg("Component.GetComponents failed")
        return list
      end
      for _, c in ipairs(comps) do
        local isCam = false
        if type(c.Type) == "string" then
          local t = string.lower(c.Type)
          if string.find(t, "camera", 1, true) or string.find(t, "uvc", 1, true) then isCam = true end
        end
        if not isCam then
          local ok2, ctrls = pcall(function() return Component.GetControls(Component.New(c.Name)) end)
          if ok2 and ctrls ~= nil then
            for _, ctl in ipairs(ctrls) do
              local n = ctl.Name
              if n == "pan.left" or n == "tilt.up"
                 or n == "ptz.preset" or n == "peripheral.camera.source" then
                isCam = true
                break
              end
            end
          end
        end
        if isCam then table.insert(list, c.Name) end
      end
      table.sort(list)
      dbg("found", #list, "cameras")
      return list
    end
  
    local function RefreshCameraLists()
      local list = DiscoverCameras()
      for i = 1, CameraCount do
        local sel = Controls[fmt("camera_select_%03d", i)]
        if sel ~= nil then
          local choices = {}
          for _, n in ipairs(list) do table.insert(choices, n) end
          local cur = sel.String
          if cur ~= nil and cur ~= "" then
            local present = false
            for _, n in ipairs(choices) do if n == cur then present = true break end end
            if not present then table.insert(choices, cur) end
          end
          sel.Choices = choices
          RebuildProxy(i)
        end
      end
      UpdateActiveName()
    end
  
    -- Drive the slot radio so exactly one button is lit. Every write is
    -- conditional: Q-Sys fires EventHandler on script writes, so an
    -- unconditional write re-triggers this radio and, when Q-Sys delivers that
    -- event after the Suppress window closes, the handler fights back and two
    -- slots latch on. Writing only on change means a settled radio emits no
    -- events at all, which is what makes it converge.
    local function WriteActiveButtons(i)
      Suppress = Suppress + 1
      for j = 1, CameraCount do
        local b = Controls[fmt("camera_active_%03d", j)]
        local want = (j == i)
        if b ~= nil and b.Boolean ~= want then b.Boolean = want end
      end
      Suppress = Suppress - 1
    end
  
    local function SetActiveIndex(i)
      ActiveIndex = i
      WriteActiveButtons(i)
      UpdateActiveName()
      BindActiveFeedback()
      if RouteActiveToRouter then RouteActiveToRouter() end
      dbg("active camera slot", i)
    end
  
    -- ===== Router tracking =====
    -- The active camera follows the source routed to a chosen router output.
    local function RouterOutputNum()
      local n = (Controls["router_output"] and Controls["router_output"].Value) or 1
      n = math.floor(n)
      if n < 1 then n = 1 end
      return n
    end
  
    -- Router components disagree on control naming: the classic Router and
    -- Router with Mixer expose "select.N", while the MediaCast Router renamed
    -- the same control to "output.N.select". Resolve the name against the bound
    -- component instead of assuming either form.
    local SELECT_FORMS = {"select.%d", "output.%d.select"}
  
    -- Snapshot the bound router's control names so a renamed readout can be
    -- matched by pattern rather than guessed.
    local function IndexRouterControls()
      RouterCtlNames = {}
      if RouterProxy == nil then return end
      local ok, ctrls = pcall(function() return Component.GetControls(RouterProxy) end)
      if not ok or ctrls == nil then return end
      for _, ctl in ipairs(ctrls) do
        if type(ctl.Name) == "string" then table.insert(RouterCtlNames, ctl.Name) end
      end
      table.sort(RouterCtlNames)
      dbg("router controls:", table.concat(RouterCtlNames, " "))
    end
  
    local function ResolveSelectCtl(out)
      for _, form in ipairs(SELECT_FORMS) do
        local name = fmt(form, out)
        if HasControl(RouterProxy, name) then return name end
      end
      return nil
    end
  
    -- Routed-source-name readout: the classic name first, then any control on
    -- this router whose name carries "source", "name" and the output index.
    local function ResolveSourceNameCtl(out)
      local classic = fmt("output.%d.source.name", out)
      if HasControl(RouterProxy, classic) then return classic end
      local tok = "." .. out .. "."
      for _, name in ipairs(RouterCtlNames) do
        local lower = string.lower(name)
        if string.find(lower, "source", 1, true)
           and string.find(lower, "name", 1, true)
           and string.find("." .. lower .. ".", tok, 1, true) then
          return name
        end
      end
      return nil
    end
  
    local function ResolveRouterCtls()
      RouterSelCtl = nil
      RouterSrcCtl = nil
      if RouterProxy == nil then return end
      local out = RouterOutputNum()
      RouterSelCtl = ResolveSelectCtl(out)
      RouterSrcCtl = ResolveSourceNameCtl(out)
      if RouterSelCtl == nil then
        dbg("router exposes no output-select control for output", out)
      else
        dbg("router output", out, "select control", RouterSelCtl)
      end
    end
  
    -- Router output select (Integer input index) drives the active slot.
    local function ApplyRouterTracking()
      if RouterProxy == nil then return end
      local k, src
      if RouterSelCtl ~= nil then pcall(function() k   = RouterProxy[RouterSelCtl].Value end) end
      if RouterSrcCtl ~= nil then pcall(function() src = RouterProxy[RouterSrcCtl].String end) end
      local srcCtl = Controls["tracked_source"]
      if srcCtl and srcCtl.String ~= (src or "") then srcCtl.String = src or "" end
      if k ~= nil then
        k = math.floor(k)
        if k >= 1 and k <= CameraCount and k ~= ActiveIndex then
          RouterApplying = true   -- this change came from the router; don't route back
          SetActiveIndex(k)
          RouterApplying = false
        end
      end
    end
  
    -- Route the active camera to the output: slot index == router input index.
    RouteActiveToRouter = function()
      if RouterApplying or RouterProxy == nil then return end
      if RouterSelCtl == nil then ResolveRouterCtls() end
      local selCtl = RouterSelCtl
      if selCtl ~= nil then
        pcall(function()
          if math.floor((RouterProxy[selCtl].Value or -1)) ~= ActiveIndex then
            RouterProxy[selCtl].Value = ActiveIndex
          end
        end)
        dbg("routed output", RouterOutputNum(), "-> input", ActiveIndex)
      end
    end
  
    local function UnbindRouter()
      if RouterProxy ~= nil and RouterBoundCtl ~= nil and HasControl(RouterProxy, RouterBoundCtl) then
        pcall(function() RouterProxy[RouterBoundCtl].EventHandler = nil end)
      end
      RouterBoundCtl = nil
    end
  
    local function BindRouter()
      UnbindRouter()
      if RouterProxy == nil then
        RouterSelCtl = nil
        RouterSrcCtl = nil
        return
      end
      ResolveRouterCtls()
      local selCtl = RouterSelCtl
      if selCtl ~= nil then
        pcall(function()
          RouterProxy[selCtl].EventHandler = function() ApplyRouterTracking() end
        end)
        RouterBoundCtl = selCtl
      end
      ApplyRouterTracking()
    end
  
    local function RebuildRouterProxy()
      UnbindRouter()
      RouterProxy = nil
      local sel = Controls["router_select"]
      local name = sel and sel.String or ""
      if name ~= "" then
        local ok, comp = pcall(Component.New, name)
        if ok and comp ~= nil then RouterProxy = comp end
      end
      IndexRouterControls()
      local foundCtl = Controls["router_found"]
      if foundCtl and foundCtl.Boolean ~= (RouterProxy ~= nil) then foundCtl.Boolean = (RouterProxy ~= nil) end
      local srcCtl = Controls["tracked_source"]
      if RouterProxy == nil and srcCtl and srcCtl.String ~= "" then srcCtl.String = "" end
      BindRouter()
    end
  
    -- Find router / mediacast-router components in the design.
    local function DiscoverRouters()
      local list = {}
      local ok, comps = pcall(Component.GetComponents)
      if not ok or comps == nil then return list end
      for _, c in ipairs(comps) do
        local isR = false
        if type(c.Type) == "string" and string.find(string.lower(c.Type), "router", 1, true) then
          isR = true
        end
        if not isR then
          local ok2, ctrls = pcall(function() return Component.GetControls(Component.New(c.Name)) end)
          if ok2 and ctrls ~= nil then
            for _, ctl in ipairs(ctrls) do
              -- "select.1" = classic Router; "output.1.select" = MediaCast Router
              if ctl.Name == "select.1" or ctl.Name == "output.1.select" then isR = true break end
            end
          end
        end
        if isR then table.insert(list, c.Name) end
      end
      table.sort(list)
      return list
    end
  
    local function RefreshRouterList()
      local sel = Controls["router_select"]
      if sel == nil then return end
      local list = DiscoverRouters()
      local cur = sel.String
      if cur ~= nil and cur ~= "" then
        local present = false
        for _, n in ipairs(list) do if n == cur then present = true break end end
        if not present then table.insert(list, cur) end
      end
      table.insert(list, 1, "")  -- blank option = no tracking
      sel.Choices = list
      RebuildRouterProxy()
    end
  
    -- ===== Event handlers =====
    if Controls["router_select"] ~= nil then
      Controls["router_select"].EventHandler = function() RebuildRouterProxy() end
    end
    if Controls["router_output"] ~= nil then
      Controls["router_output"].EventHandler = function() BindRouter() end
    end
  
    for i = 1, CameraCount do
      local sel = Controls[fmt("camera_select_%03d", i)]
      local act = Controls[fmt("camera_active_%03d", i)]
      if sel ~= nil then
        sel.EventHandler = function()
          RebuildProxy(i)
          if i == ActiveIndex then UpdateActiveName(); BindActiveFeedback(); if RouteActiveToRouter then RouteActiveToRouter() end end
        end
      end
      if act ~= nil then
        act.EventHandler = function(ctl)
          if Suppress > 0 then return end
          if ctl.Boolean then
            SetActiveIndex(i)
          else
            -- A slot went low. Never force THIS slot back high: that fights the
            -- radio write and latches two slots on. Re-assert the real active
            -- slot instead -- idempotent, so a correct radio settles silently
            -- and pressing the active slot simply re-lights it.
            WriteActiveButtons(ActiveIndex)
          end
        end
      end
    end
  
    for name, target in pairs(PTZ_MAP) do
      local ctl = Controls[name]
      if ctl ~= nil then
        ctl.EventHandler = function(c) SetCtl(target, c.Boolean) end
      end
    end
  
    for name, def in pairs(DIAG_MAP) do
      local ctl = Controls[name]
      if ctl ~= nil then
        ctl.EventHandler = function(c) DriveDiagonal(def, c.Boolean) end
      end
    end
  
    for name, target in pairs(TRIGGER_MAP) do
      local ctl = Controls[name]
      if ctl ~= nil then
        ctl.EventHandler = function() PulseCtl(target) end
      end
    end
  
    if Controls["privacy_load"] ~= nil then
      Controls["privacy_load"].EventHandler = function(ctl)
        if PrivacyFbSuppress then return end
        SetCtl(PRIVACY_TOGGLE, ctl.Boolean)
      end
    end
  
    for _, n in ipairs(NUM_MIRROR) do
      local ctl = Controls[n]
      if ctl ~= nil then
        ctl.EventHandler = function(c)
          if NumFbSuppress[n] then return end
          local cam = ActiveCam()
          if cam ~= nil and HasControl(cam, n) then
            pcall(function()
              if cam[n].Value ~= c.Value then cam[n].Value = c.Value end
            end)
          end
        end
      end
    end
  
    if Controls[WB_MODE] ~= nil then
      Controls[WB_MODE].EventHandler = function(ctl)
        if WbModeFbSuppress then return end
        local cam = ActiveCam()
        if cam ~= nil and HasControl(cam, WB_MODE) then
          pcall(function()
            if cam[WB_MODE].String ~= ctl.String then cam[WB_MODE].String = ctl.String end
          end)
        end
      end
    end
  
    if Controls["ptz_af"] ~= nil then
      Controls["ptz_af"].EventHandler = function() PulseCtl("focus.auto") end
    end
  
    -- Editing the Coordinates field writes the position to the active camera.
    if Controls["coordinates"] ~= nil then
      Controls["coordinates"].EventHandler = function(ctl)
        if CoordFbSuppress then return end
        local cam = ActiveCam()
        if cam ~= nil and HasControl(cam, COORD_CTRL) then
          pcall(function()
            if cam[COORD_CTRL].String ~= ctl.String then cam[COORD_CTRL].String = ctl.String end
          end)
        end
      end
    end
  
    -- Tap = recall; hold = save the moment the hold time elapses (while held).
    local Saved = {}
    local Countdown = {}
    for p = 1, NumPresets do
      local btn = Controls[fmt("preset_%03d", p)]
      if btn ~= nil then
        Saved[p] = false
        Countdown[p] = Timer.New()
        Countdown[p].EventHandler = function()
          Countdown[p]:Stop()
          PresetHoldSave(p)   -- fires as soon as the hold completes
          Saved[p] = true
        end
        btn.EventHandler = function(ctl)
          if PresetFbSuppress then return end   -- ignore highlight-driven writes
          if ctl.Boolean then
            Saved[p] = false
            Countdown[p]:Start(HoldTime)
          else
            Countdown[p]:Stop()
            if not Saved[p] then PresetRecallTap(p) end
            Saved[p] = false
            UpdatePresetHighlights()
          end
        end
      end
    end
  
    -- ===== Initialise =====
    LoadStore()
    RefreshCameraLists()
  
    local initActive = 1
    for j = 1, CameraCount do
      local b = Controls[fmt("camera_active_%03d", j)]
      if b ~= nil and b.Boolean then initActive = j break end
    end
    SetActiveIndex(initActive)
  
    RefreshRouterList()  -- may override the active camera if a router is tracking
end
